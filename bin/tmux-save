#!/usr/bin/env bash
# Save tmux session layout to persistent storage.
# Called periodically by entrypoint and by preStop hook.
set -euo pipefail

LAYOUT_FILE="${HOME:-/home/claude}/.local/state/kordinate/tmux-layout.json"
LAYOUT_TMP="${LAYOUT_FILE}.tmp.$$"

mkdir -p "$(dirname "$LAYOUT_FILE")"

# Bail if tmux server is not running
tmux list-sessions &>/dev/null || exit 0

# Build JSON using python3 for safe serialization
tmux list-windows -a -F '#{session_name}	#{window_index}	#{window_name}	#{pane_current_path}' \
  | python3 -c "
import json, sys
from datetime import datetime, timezone

sessions = {}
for line in sys.stdin:
    parts = line.strip().split('\t')
    if len(parts) != 4:
        continue
    sess, idx, name, path = parts
    if sess not in sessions:
        sessions[sess] = {'name': sess, 'windows': []}
    sessions[sess]['windows'].append({
        'index': int(idx),
        'name': name,
        'path': path
    })

for s in sessions.values():
    s['windows'].sort(key=lambda w: w['index'])

layout = {
    'saved_at': datetime.now(timezone.utc).isoformat(),
    'sessions': sorted(sessions.values(), key=lambda s: s['name'])
}

json.dump(layout, sys.stdout, indent=2)
print()
" > "$LAYOUT_TMP"

# Atomic rename to avoid partial reads during rolling update
mv "$LAYOUT_TMP" "$LAYOUT_FILE"
