#!/usr/bin/env bash
# Start Claude Code with explicit worktree selection.
#
# Behavior:
# - Outside tmux: attach/create 0-general and rerun inside it
# - Outside a git repo: run Claude directly
# - Inside an existing worktree: use it as-is
# - From repo main tree: select existing worktree, create a new worktree, or inspect current tree
#
# Launcher-only: no implicit pull/commit/push/merge/cleanup.
# Usage: bin/claude-session [--pick-worktree] [--new-worktree <slug>] [--select-worktree <selector>] [--inspect-current-tree] [claude args...]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALL_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
REPO_ROOT_DEFAULT="/kord/projects/kordinate"

CLAUDE_BIN="openclaude"
# Source nvm to make openclaude available when launched outside a login shell.
if [ -f "$HOME/.nvm/nvm.sh" ]; then
  source "$HOME/.nvm/nvm.sh"
fi

TMUX_DEFAULT="0-general"
PICK_WORKTREE=0
INSPECT_CURRENT_TREE=0
NEW_WORKTREE_SLUG=""
SELECT_WORKTREE=""
CLAUDE_ARGS=()

usage() {
  cat <<'EOF'
Usage: claude-session [launcher options] [--] [claude args...]

Launcher options:
  --pick-worktree             Show worktree picker when launched from repo main tree
  --new-worktree <slug>       Create or reuse the named session worktree
  --select-worktree <value>   Select an existing worktree by path, slug, or session/* branch
  --inspect-current-tree      Run Claude in the current tree without creating/selecting a worktree
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --pick-worktree)
      PICK_WORKTREE=1
      shift
      ;;
    --inspect-current-tree)
      INSPECT_CURRENT_TREE=1
      shift
      ;;
    --new-worktree)
      NEW_WORKTREE_SLUG="${2:-}"
      [[ -n "$NEW_WORKTREE_SLUG" ]] || { echo "Missing value for --new-worktree" >&2; exit 1; }
      shift 2
      ;;
    --select-worktree)
      SELECT_WORKTREE="${2:-}"
      [[ -n "$SELECT_WORKTREE" ]] || { echo "Missing value for --select-worktree" >&2; exit 1; }
      shift 2
      ;;
    --help)
      usage
      exit 0
      ;;
    --)
      shift
      CLAUDE_ARGS+=("$@")
      break
      ;;
    *)
      CLAUDE_ARGS+=("$1")
      shift
      ;;
  esac
done

warn_if_repo_drift() {
  local repo_root="${KORDINATE_REPO:-$REPO_ROOT_DEFAULT}"
  local repo_bin="$repo_root/bin"
  local compared=0
  local drift=0
  local name repo_file installed_file

  [[ "$INSTALL_ROOT" != "$repo_root" ]] || return 0
  [[ -d "$repo_bin" ]] || return 0

  for name in claude-session session-status tmux-new-window tmux-session.bash tmux-save tmux-restore; do
    repo_file="$repo_bin/$name"
    installed_file="$INSTALL_ROOT/bin/$name"
    [[ -f "$repo_file" && -f "$installed_file" ]] || continue
    compared=1
    if ! cmp -s "$repo_file" "$installed_file"; then
      drift=1
      break
    fi
  done

  if [[ $compared -eq 1 && $drift -eq 1 ]]; then
    printf 'Warning: installed kordinate runtime differs from %s; refresh /kord/kordinate from repo to pick up latest session behavior.\n' "$repo_root" >&2
  fi
}

warn_if_repo_drift


rerun_inside_tmux() {
  local cmd
  printf -v cmd '%q ' "$0"
  if [[ $PICK_WORKTREE -eq 1 ]]; then
    cmd+="--pick-worktree "
  fi
  if [[ $INSPECT_CURRENT_TREE -eq 1 ]]; then
    cmd+="--inspect-current-tree "
  fi
  if [[ -n "$NEW_WORKTREE_SLUG" ]]; then
    printf -v cmd '%s--new-worktree %q ' "$cmd" "$NEW_WORKTREE_SLUG"
  fi
  if [[ -n "$SELECT_WORKTREE" ]]; then
    printf -v cmd '%s--select-worktree %q ' "$cmd" "$SELECT_WORKTREE"
  fi
  for arg in "${CLAUDE_ARGS[@]}"; do
    printf -v cmd '%s%q ' "$cmd" "$arg"
  done
  exec command tmux attach-session -t "$TMUX_DEFAULT" \; send-keys "$cmd" Enter
}

if [[ -z "${TMUX:-}" ]]; then
  command tmux has-session -t "$TMUX_DEFAULT" 2>/dev/null || command tmux new-session -d -s "$TMUX_DEFAULT"
  rerun_inside_tmux
fi

safe_fetch() {
  local tree_root="$1"
  git -C "$tree_root" remote 2>/dev/null | grep -q . || return 0
  git -C "$tree_root" fetch --all --prune 2>/dev/null || true
}

prune_worktrees() {
  local repo_root="$1"
  git -C "$repo_root" worktree prune >/dev/null 2>&1 || true
}

current_tree_root() {
  git rev-parse --show-toplevel 2>/dev/null || true
}

main_repo_root() {
  local common_dir candidate
  common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
  candidate="${common_dir%/.git}"
  if [[ -n "$candidate" && -d "$candidate/.git" ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi
  git rev-parse --show-toplevel 2>/dev/null || true
}

sanitize_slug() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9._-]+/-/g; s/^-+//; s/-+$//; s/-+/-/g'
}

print_sync_summary() {
  local tree_root="$1"
  local branch dirty upstream ahead=0 behind=0 main_behind=0
  branch=$(git -C "$tree_root" branch --show-current 2>/dev/null || echo "detached")
  if [[ -n "$(git -C "$tree_root" status --porcelain 2>/dev/null)" ]]; then
    dirty="dirty"
  else
    dirty="clean"
  fi
  if upstream=$(git -C "$tree_root" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null); then
    read -r ahead behind < <(git -C "$tree_root" rev-list --left-right --count HEAD..."$upstream" 2>/dev/null || printf '0 0')
  fi
  if git -C "$tree_root" show-ref --verify --quiet refs/remotes/origin/main 2>/dev/null; then
    read -r _ main_behind < <(git -C "$tree_root" rev-list --left-right --count HEAD...origin/main 2>/dev/null || printf '0 0')
  elif git -C "$tree_root" show-ref --verify --quiet refs/heads/main 2>/dev/null; then
    read -r _ main_behind < <(git -C "$tree_root" rev-list --left-right --count HEAD...main 2>/dev/null || printf '0 0')
  fi
  printf 'branch:%s upstream:+%s/-%s main:+%s %s\n' "$branch" "$ahead" "$behind" "$main_behind" "$dirty"
}

run_claude_continue() {
  local exit_code
  set +e
  "$CLAUDE_BIN" --continue "${CLAUDE_ARGS[@]}"
  exit_code=$?
  set -e
  if [[ $exit_code -ne 0 ]]; then
    echo "No prior conversation — starting fresh"
    exec "$CLAUDE_BIN" "${CLAUDE_ARGS[@]}"
  fi
  return 0
}

run_claude_fresh() {
  exec "$CLAUDE_BIN" "${CLAUDE_ARGS[@]}"
}

enter_tree() {
  local tree_root="$1"
  local mode="${2:-resume}"
  safe_fetch "$tree_root"
  cd "$tree_root"
  printf 'Using %s\n' "$tree_root"
  print_sync_summary "$tree_root"
  if [[ "$mode" == "fresh" ]]; then
    run_claude_fresh
  else
    run_claude_continue
  fi
}

list_session_worktrees() {
  local repo_root="$1"
  local path=""
  local branch=""
  while IFS= read -r line; do
    case "$line" in
      worktree\ *)
        path="${line#worktree }"
        branch=""
        ;;
      branch\ refs/heads/session/*)
        branch="${line#branch refs/heads/}"
        if [[ -n "$path" && -d "$path" ]]; then
          printf '%s\t%s\t%s\n' "$(basename "$path")" "$branch" "$path"
        fi
        ;;
      '')
        path=""
        branch=""
        ;;
    esac
  done < <(git -C "$repo_root" worktree list --porcelain 2>/dev/null)
}

ensure_session_worktree() {
  local repo_root="$1"
  local slug branch worktree_path
  slug=$(sanitize_slug "$2")
  [[ -n "$slug" ]] || { echo "Worktree name cannot be empty" >&2; return 1; }
  branch="session/$slug"
  worktree_path="$repo_root/.worktrees/$slug"
  mkdir -p "$repo_root/.worktrees"
  if [[ -d "$worktree_path" ]]; then
    printf '%s\n' "$worktree_path"
    return 0
  fi
  if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
    git -C "$repo_root" worktree add "$worktree_path" "$branch"
  else
    git -C "$repo_root" worktree add "$worktree_path" -b "$branch"
  fi
  printf '%s\n' "$worktree_path"
}

resolve_selected_worktree() {
  local repo_root="$1"
  local selector="$2"
  local name branch path
  while IFS=$'\t' read -r name branch path; do
    if [[ "$selector" == "$path" || "$selector" == "$name" || "$selector" == "$branch" ]]; then
      printf '%s\n' "$path"
      return 0
    fi
  done < <(list_session_worktrees "$repo_root")
  return 1
}

pick_worktree_action() {
  local repo_root="$1"
  local labels=("create new worktree" "inspect current tree")
  local mappings=("__CREATE__" "__INSPECT__")
  local name branch path
  while IFS=$'\t' read -r name branch path; do
    labels+=("$name [$branch] — $path")
    mappings+=("$path")
  done < <(list_session_worktrees "$repo_root")

  echo "Select OpenClaude session target:" >&2
  PS3='Choice: '
  select choice in "${labels[@]}"; do
    if [[ -n "${choice:-}" ]]; then
      printf '%s\n' "${mappings[$((REPLY - 1))]}"
      return 0
    fi
  done
}

prompt_new_slug() {
  local default_slug slug
  default_slug="$(date +%Y%m%d-%H%M%S)"
  read -r -p "New worktree name [$default_slug]: " slug
  slug="${slug:-$default_slug}"
  sanitize_slug "$slug"
}

repo_root=$(current_tree_root)
if [[ -z "$repo_root" ]]; then
  echo "Not in a git repo — running claude directly"
  exec "$CLAUDE_BIN" "${CLAUDE_ARGS[@]}"
fi

main_root=$(main_repo_root)
prune_worktrees "$repo_root"
if [[ -z "$main_root" ]]; then
  echo "Could not determine repository root — running claude directly"
  exec "$CLAUDE_BIN" "${CLAUDE_ARGS[@]}"
fi

if [[ $INSPECT_CURRENT_TREE -eq 1 ]]; then
  enter_tree "$repo_root" fresh
  exit 0
fi

if [[ "$repo_root" != "$main_root" ]]; then
  enter_tree "$repo_root" resume
  exit 0
fi

selected_path=""
if [[ -n "$SELECT_WORKTREE" ]]; then
  selected_path=$(resolve_selected_worktree "$main_root" "$SELECT_WORKTREE" || true)
  [[ -n "$selected_path" ]] || { echo "No worktree matched: $SELECT_WORKTREE" >&2; exit 1; }
elif [[ -n "$NEW_WORKTREE_SLUG" ]]; then
  selected_path=$(ensure_session_worktree "$main_root" "$NEW_WORKTREE_SLUG")
else
  selection=$(pick_worktree_action "$main_root")
  case "$selection" in
    __CREATE__)
      selected_path=$(ensure_session_worktree "$main_root" "$(prompt_new_slug)")
      ;;
    __INSPECT__)
      selected_path="$main_root"
      ;;
    *)
      selected_path="$selection"
      ;;
  esac
fi

if [[ -n "$NEW_WORKTREE_SLUG" ]]; then
  enter_tree "$selected_path" fresh
else
  enter_tree "$selected_path" resume
fi
