#!/usr/bin/env bash
# Start Claude Code in an isolated git worktree.
# - In tmux: worktree is keyed by tmux session+window (reused on re-run = auto resume)
# - Outside tmux: falls back to timestamp-based worktree
# - On exit: pushes + creates PR if changes exist, cleans up if not
# Usage: bin/claude-session [claude args...]

set -e

CLAUDE="claude"

repo_root=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ -z "$repo_root" ]; then
  echo "Not in a git repo — running claude directly"
  exec $CLAUDE "$@"
fi

# Ensure tmux session name matches the repo name
repo=$(basename "$repo_root")
if [ -n "$TMUX" ]; then
  current_session=$(tmux display-message -p '#{session_name}')
  if [ "$current_session" != "$repo" ]; then
    if tmux has-session -t "=$repo" 2>/dev/null; then
      # Session exists — create a new window there
      tmux new-window -t "=$repo" -c "$repo_root" "$0 $*"
      exit 0
    else
      # No session with repo name — create one and attach
      tmux new-session -d -s "$repo" -c "$repo_root" "$0 $*"
      tmux switch-client -t "=$repo"
      exit 0
    fi
  fi
fi

# Already in a worktree? Just run claude.
main_worktree=$(git worktree list --porcelain | head -1 | sed 's/^worktree //')
if [ "$repo_root" != "$main_worktree" ]; then
  echo "Already in a worktree — running claude directly"
  exec $CLAUDE "$@"
fi

# Create a worktree. All runtime state lives at ~/.claude/ — nothing to copy.
create_worktree() {
  local wt_path="$1" branch_arg="$2"
  mkdir -p "$(dirname "$wt_path")"
  # git-crypt smudge filter fails during normal worktree checkout because
  # the worktree doesn't have the key yet. Work around by:
  # 1. Bypass smudge/clean filters during checkout (files land as plaintext)
  # 2. Symlink git-crypt key from main repo into worktree's git dir
  # 3. No re-checkout needed — files match the committed (now encrypted) blobs
  local wt_gitdir
  wt_gitdir="$repo_root/.git/worktrees/$(basename "$wt_path")"
  git -c filter.git-crypt.smudge=cat -c filter.git-crypt.clean=cat \
    -C "$repo_root" worktree add "$wt_path" $branch_arg
  ln -sf "$repo_root/.git/git-crypt" "$wt_gitdir/git-crypt"
  # Re-checkout encrypted files with proper smudge filter now that key is available
  git -C "$wt_path" checkout HEAD -- .
  mkdir -p "$wt_path/.claude/agent-state"
}

# Generate session ID: tmux-based (stable) or timestamp (fallback)
if [ -n "$TMUX" ]; then
  tmux_window=$(tmux display-message -p '#{window_index}')
  # Window 0 stays on main — no worktree
  if [ "$tmux_window" = "0" ]; then
    echo "Window 0 — running on main directly"
    exec $CLAUDE "$@"
  fi
  session_id="w${tmux_window}-${repo}"
else
  session_id="$(date +%Y%m%d-%H%M%S)-${repo}"
fi

branch="session/${session_id}"
worktree="${repo_root}/.worktrees/${session_id}"

# Try --continue, fall back to fresh start if no conversation exists
run_claude_continue() {
  set +e
  $CLAUDE --continue "$@"
  exit_code=$?
  set -e
  if [ $exit_code -ne 0 ]; then
    echo "No prior conversation — starting fresh"
    set +e
    $CLAUDE "$@"
    exit_code=$?
    set -e
  fi
}

# Reuse existing worktree if it exists (auto-resume)
if [ -d "$worktree" ]; then
  echo "Resuming session: $worktree (branch: $branch)"
  cd "$worktree"
  run_claude_continue "$@"
# Branch exists but worktree was cleaned up — recreate worktree and resume
elif git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
  create_worktree "$worktree" "$branch"
  echo "Resuming session (worktree recreated): $worktree (branch: $branch)"
  cd "$worktree"
  run_claude_continue "$@"
# Fresh session
else
  git -C "$repo_root" pull --ff-only 2>/dev/null || true
  create_worktree "$worktree" "-b $branch"
  echo "New session: $worktree (branch: $branch)"
  cd "$worktree"
  set +e
  $CLAUDE "$@"
  exit_code=$?
  set -e
fi

# Cleanup or push+PR
commits=$(git log main..HEAD --oneline 2>/dev/null | wc -l | tr -d ' ')
dirty=$(git status --porcelain 2>/dev/null)

if [ "$commits" -eq 0 ] && [ -z "$dirty" ]; then
  echo "No changes — cleaning up worktree"
  cd "$repo_root"
  git worktree remove "$worktree" 2>/dev/null || true
  git branch -d "$branch" 2>/dev/null || true
else
  # Commit any uncommitted work
  if [ -n "$dirty" ]; then
    echo "Committing uncommitted changes..."
    git add -A
    git commit -m "wip: uncommitted changes at session exit"
  fi

  # Push and create PR if one doesn't exist
  echo "Pushing session branch..."
  git push -u origin "$branch" 2>/dev/null || git push --force-with-lease origin "$branch"

  existing_pr=$(gh pr list --head "$branch" --json number --jq '.[0].number' 2>/dev/null)
  if [ -z "$existing_pr" ]; then
    echo "Creating PR..."
    gh pr create \
      --title "session: ${session_id}" \
      --body "Auto-created from Claude session worktree." \
      --base main \
      --head "$branch" 2>/dev/null || echo "PR creation failed — push succeeded, create manually"
  else
    echo "PR #$existing_pr already exists"
  fi

  echo "Session preserved at: $worktree (branch: $branch)"
fi

exit $exit_code
