#!/usr/bin/env bash
# push-to-kordinate — sync shared framework files from ~/.claude back to ~/kordinate and push both repos
#
# Flow: ~/.claude (installation) → ~/kordinate (shared source) → GitHub
# Projects/ files stay in claude-profile only (user-specific).
set -euo pipefail

CLAUDE_DIR="$HOME/.claude"
KORDINATE_HOME="$HOME/kordinate"

# Helper: copy file, chmod u+w destination first if it exists (scribe sets 444)
safe_cp() { [ -f "$2" ] && chmod u+w "$2" 2>/dev/null; cp "$1" "$2"; }

# ═══ Step 1: Commit and push claude-profile (everything) ═══
echo "=== claude-profile ==="
cd "$CLAUDE_DIR"

remote=$(git remote get-url origin 2>/dev/null || true)
if [[ "$remote" != *"claude-profile"* ]]; then
    echo "ERROR: ~/.claude expected claude-profile remote, got: $remote" >&2
    exit 1
fi

git add -A
if ! git diff --cached --quiet; then
    msg="${1:-profile: sync $(date +%Y-%m-%d)}"
    git commit -m "$msg"
    echo "Committed."
fi
git pull origin main --rebase --quiet 2>/dev/null || true
git push origin main --quiet && echo "Pushed claude-profile." || echo "claude-profile push failed — check for conflicts."

# ═══ Step 2: Sync shared files from ~/.claude → ~/kordinate ═══
echo ""
echo "=== kordinate ==="

if [[ ! -d "$KORDINATE_HOME/.git" ]]; then
    echo "SKIP: $KORDINATE_HOME not found — kordinate sync skipped."
    echo "Done."
    exit 0
fi

# Global CLAUDE.md
safe_cp "$CLAUDE_DIR/CLAUDE.md" "$KORDINATE_HOME/CLAUDE.md"

# Agents: CLAUDE.md, commands/
for agent_dir in "$CLAUDE_DIR/agents"/*/; do
    [ -d "$agent_dir" ] || continue
    agent="$(basename "$agent_dir")"
    dest="$KORDINATE_HOME/agents/$agent"
    mkdir -p "$dest"

    # CLAUDE.md
    [ -f "$agent_dir/CLAUDE.md" ] && safe_cp "$agent_dir/CLAUDE.md" "$dest/CLAUDE.md"

    # commands/
    if [ -d "$agent_dir/commands" ] && [ "$(ls -A "$agent_dir/commands" 2>/dev/null)" ]; then
        mkdir -p "$dest/commands"
        find "$dest/commands" -type f -exec chmod u+w {} + 2>/dev/null || true
        cp -r "$agent_dir/commands/"* "$dest/commands/"
    fi

    # TODO: agent knowledge now lives in agent-memory/<agent>/ (top-level, not under agents/)
    # The old agents/<agent>/knowledge/ layout is deprecated.
    # agent-memory/ is synced separately below.
done

# Agent memory (agent-memory/<agent>/ — top-level, not under agents/)
if [ -d "$CLAUDE_DIR/agent-memory" ]; then
    for agent_mem_dir in "$CLAUDE_DIR/agent-memory"/*/; do
        [ -d "$agent_mem_dir" ] || continue
        agent="$(basename "$agent_mem_dir")"
        dest="$KORDINATE_HOME/agent-memory/$agent"
        mkdir -p "$dest"
        # Sync all files (skip projects/ — those are user-specific)
        for f in "$agent_mem_dir"*; do
            [ -e "$f" ] || continue
            base="$(basename "$f")"
            [ "$base" = "projects" ] && continue
            if [ -d "$f" ]; then
                mkdir -p "$dest/$base"
                find "$dest/$base" -type f -exec chmod u+w {} + 2>/dev/null || true
                cp -r "$f/"* "$dest/$base/" 2>/dev/null || true
            else
                safe_cp "$f" "$dest/$base"
            fi
        done
    done
    # Sync top-level agent-memory files (e.g., patterns.md)
    for f in "$CLAUDE_DIR/agent-memory"/*; do
        [ -f "$f" ] && safe_cp "$f" "$KORDINATE_HOME/agent-memory/$(basename "$f")"
    done
fi

# Standalone commands
if [ -d "$CLAUDE_DIR/commands" ]; then
    for f in "$CLAUDE_DIR/commands"/*; do
        base="$(basename "$f")"
        [ "$base" = "scribe" ] && continue  # handled via agents/scribe/commands
        if [ -d "$f" ]; then
            mkdir -p "$KORDINATE_HOME/commands/$base"
            find "$KORDINATE_HOME/commands/$base" -type f -exec chmod u+w {} + 2>/dev/null || true
            cp -r "$f/"* "$KORDINATE_HOME/commands/$base/"
        else
            safe_cp "$f" "$KORDINATE_HOME/commands/$base"
        fi
    done
fi

# Hooks
if [ -d "$CLAUDE_DIR/hooks" ]; then
    mkdir -p "$KORDINATE_HOME/hooks"
    for f in "$CLAUDE_DIR/hooks"/*.sh; do
        [ -f "$f" ] && safe_cp "$f" "$KORDINATE_HOME/hooks/$(basename "$f")"
    done
fi

# Bin (all scripts)
if [ -d "$CLAUDE_DIR/bin" ]; then
    mkdir -p "$KORDINATE_HOME/bin"
    for f in "$CLAUDE_DIR/bin"/*; do
        [ -f "$f" ] || continue
        cp "$f" "$KORDINATE_HOME/bin/$(basename "$f")"
    done
fi

# ═══ Step 3: Commit and push kordinate ═══
cd "$KORDINATE_HOME"

# Always work on main for kordinate syncs
current_branch=$(git branch --show-current)
if [[ "$current_branch" != "main" ]]; then
    git stash --quiet 2>/dev/null || true
    git checkout main --quiet
fi

git add -A
if ! git diff --cached --quiet; then
    git commit -m "${1:-sync from installation $(date +%Y-%m-%d)}"
    echo "Committed."
fi
git pull origin main --rebase --quiet 2>/dev/null || true
git push origin main --quiet && echo "Pushed kordinate." || echo "kordinate push failed — check for conflicts."

# Return to previous branch if we switched
if [[ "$current_branch" != "main" ]]; then
    git checkout "$current_branch" --quiet
    git stash pop --quiet 2>/dev/null || true
fi

echo ""
echo "Done."
