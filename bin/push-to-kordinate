#!/usr/bin/env bash
# push-to-kordinate — commit locally (with projects/), push filtered (without projects/) to kordinate
# Projects/ contain user-specific knowledge and are excluded from the shared remote.
set -euo pipefail

PROFILE_DIR="$HOME/.claude"
cd "$PROFILE_DIR"

# Safety: ensure we're in the right repo
remote=$(git remote get-url origin 2>/dev/null || true)
if [[ "$remote" != *"claude-profile"* ]]; then
    echo "ERROR: expected claude-profile remote, got: $remote" >&2
    exit 1
fi

# Stage and commit everything locally (including projects/)
git add -A
if ! git diff --cached --quiet; then
    msg="${1:-profile: sync $(date +%Y-%m-%d)}"
    git commit -m "$msg"
    echo "Committed locally."
else
    echo "No local changes to commit."
fi

# Check if there's anything new to push by diffing local vs remote (excluding projects/)
git fetch origin --quiet
if git diff HEAD origin/main -- . ':(exclude)*/knowledge/projects' --quiet 2>/dev/null; then
    echo "Nothing to push — kordinate is up to date."
    exit 0
fi

# Create filtered branch from current HEAD
echo "Creating filtered push..."
git branch -D _kordinate_push 2>/dev/null || true
git checkout -b _kordinate_push

# Remove projects/ from index only (keeps files on disk)
project_files=$(git ls-files -- '*/knowledge/projects/*' 2>/dev/null || true)
if [[ -n "$project_files" ]]; then
    echo "$project_files" | xargs git rm --cached -r --quiet
    git commit -m "filtered: exclude user-specific projects/" --allow-empty
fi

# Push filtered branch to kordinate main
git push origin _kordinate_push:main --force-with-lease
echo "Pushed to kordinate (projects/ excluded)."

# Return to main and clean up
git checkout -f main
git branch -D _kordinate_push
echo "Done."
