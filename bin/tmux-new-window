#!/usr/bin/env bash
# Create a new tmux window in the current worktree/path.
#
# tmux manages layout only. It should not silently switch repos, sessions,
# or worktrees behind the user's back.

set -euo pipefail

pane_path="${1:-}"

if [[ -n "$pane_path" && -d "$pane_path" ]]; then
  exec tmux new-window -c "$pane_path"
fi

exec tmux new-window
