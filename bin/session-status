#!/usr/bin/env bash
# Inspect and manage worktree-backed Claude sessions.
#
# Usage:
#   session-status [list|current|new <name>|resume <selector>|inspect|prune]

set -euo pipefail

command_name="claude-session"
mode="${1:-list}"
shift || true

usage() {
  cat <<'EOF'
Usage: session-status [list|current|new <name>|resume <selector>|inspect|prune]

Commands:
  list              List session worktrees and sync state (default)
  current           Show the current repo/worktree/branch and sync state
  new <name>        Print the command to create or reuse a named worktree session
  resume <selector> Print the command to resume an existing worktree by slug, branch, or path
  inspect           Print the command to run Claude in the current tree
  prune             Prune stale worktree metadata and report the remaining session worktrees
EOF
}

current_tree_root() {
  git rev-parse --show-toplevel 2>/dev/null || true
}

main_repo_root() {
  local common_dir candidate
  common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
  candidate="${common_dir%/.git}"
  if [[ -n "$candidate" && -d "$candidate/.git" ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi
  git rev-parse --show-toplevel 2>/dev/null || true
}

safe_fetch() {
  local tree_root="$1"
  git -C "$tree_root" remote 2>/dev/null | grep -q . || return 0
  git -C "$tree_root" fetch --all --prune 2>/dev/null || true
}

prune_worktrees() {
  local repo_root="$1"
  git -C "$repo_root" worktree prune >/dev/null 2>&1 || true
}

worktree_label() {
  local root="$1"
  local main_root="$2"
  if [[ "$root" == "$main_root" ]]; then
    printf 'main'
  else
    printf '%s' "$(basename "$root")"
  fi
}

sync_fields() {
  local tree_root="$1"
  local branch dirty upstream ahead=0 behind=0 main_behind=0
  branch=$(git -C "$tree_root" branch --show-current 2>/dev/null || echo "detached")
  if [[ -n "$(git -C "$tree_root" status --porcelain 2>/dev/null)" ]]; then
    dirty="dirty"
  else
    dirty="clean"
  fi
  if upstream=$(git -C "$tree_root" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null); then
    read -r ahead behind < <(git -C "$tree_root" rev-list --left-right --count HEAD..."$upstream" 2>/dev/null || printf '0 0')
  fi
  if git -C "$tree_root" show-ref --verify --quiet refs/remotes/origin/main 2>/dev/null; then
    read -r _ main_behind < <(git -C "$tree_root" rev-list --left-right --count HEAD...origin/main 2>/dev/null || printf '0 0')
  elif git -C "$tree_root" show-ref --verify --quiet refs/heads/main 2>/dev/null; then
    read -r _ main_behind < <(git -C "$tree_root" rev-list --left-right --count HEAD...main 2>/dev/null || printf '0 0')
  fi
  printf '%s\t%s\t%s\t%s\n' "$branch" "$ahead" "$behind" "$main_behind $dirty"
}

list_session_worktrees() {
  local repo_root="$1"
  local path=""
  local branch=""
  while IFS= read -r line; do
    case "$line" in
      worktree\ *)
        path="${line#worktree }"
        branch=""
        ;;
      branch\ refs/heads/session/*)
        branch="${line#branch refs/heads/}"
        if [[ -n "$path" && -d "$path" ]]; then
          printf '%s\t%s\n' "$branch" "$path"
        fi
        ;;
      '')
        path=""
        branch=""
        ;;
    esac
  done < <(git -C "$repo_root" worktree list --porcelain 2>/dev/null)
}

resolve_selected_worktree() {
  local repo_root="$1"
  local selector="$2"
  local branch path
  while IFS=$'\t' read -r branch path; do
    if [[ "$selector" == "$path" || "$selector" == "$(basename "$path")" || "$selector" == "$branch" ]]; then
      printf '%s\n' "$path"
      return 0
    fi
  done < <(list_session_worktrees "$repo_root")
  return 1
}

repo_root=$(current_tree_root)
if [[ -z "$repo_root" ]]; then
  echo "Not in a git repo."
  exit 1
fi
main_root=$(main_repo_root)
[[ -n "$main_root" ]] || { echo "Could not determine repository root."; exit 1; }
prune_worktrees "$main_root"

case "$mode" in
  list)
    safe_fetch "$main_root"
    printf 'repo\tworktree\tbranch\tupstream\tmain drift\tstate\tpath\n'
    if [[ "$repo_root" == "$main_root" ]]; then
      IFS=$'\t' read -r branch ahead behind rest < <(sync_fields "$main_root")
      printf '%s\t%s\t%s\t+%s/-%s\t%s\t%s\t%s\n' "$(basename "$main_root")" "main" "$branch" "$ahead" "$behind" "${rest%% *}" "${rest#* }" "$main_root"
    fi
    while IFS=$'\t' read -r branch path; do
      IFS=$'\t' read -r actual_branch ahead behind rest < <(sync_fields "$path")
      printf '%s\t%s\t%s\t+%s/-%s\t%s\t%s\t%s\n' "$(basename "$main_root")" "$(basename "$path")" "$actual_branch" "$ahead" "$behind" "${rest%% *}" "${rest#* }" "$path"
    done < <(list_session_worktrees "$main_root")
    ;;
  current)
    safe_fetch "$repo_root"
    IFS=$'\t' read -r branch ahead behind rest < <(sync_fields "$repo_root")
    printf 'repo: %s\n' "$(basename "$main_root")"
    printf 'worktree: %s\n' "$(worktree_label "$repo_root" "$main_root")"
    printf 'path: %s\n' "$repo_root"
    printf 'branch: %s\n' "$branch"
    printf 'upstream: +%s/-%s\n' "$ahead" "$behind"
    printf 'main drift: %s\n' "${rest%% *}"
    printf 'state: %s\n' "${rest#* }"
    ;;
  new)
    [[ $# -gt 0 ]] || { echo "Missing worktree name." >&2; exit 1; }
    printf '%s --new-worktree %q\n' "$command_name" "$1"
    ;;
  resume)
    [[ $# -gt 0 ]] || { echo "Missing worktree selector." >&2; exit 1; }
    if resolve_selected_worktree "$main_root" "$1" >/dev/null 2>&1; then
      printf '%s --select-worktree %q\n' "$command_name" "$1"
    else
      echo "No worktree matched: $1" >&2
      exit 1
    fi
    ;;
  inspect)
    printf '%s --inspect-current-tree\n' "$command_name"
    ;;
  prune)
    printf 'Pruned stale worktree metadata for %s\n' "$main_root"
    while IFS=$'\t' read -r branch path; do
      printf '%s\t%s\n' "$branch" "$path"
    done < <(list_session_worktrees "$main_root")
    ;;
  --help|-h|help)
    usage
    ;;
  *)
    echo "Unknown command: $mode" >&2
    usage
    exit 1
    ;;
esac
