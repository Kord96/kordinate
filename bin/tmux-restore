#!/usr/bin/env bash
# Restore tmux session layout from persistent storage.
# Called by entrypoint at boot, before SSH connections arrive.
set -euo pipefail

LAYOUT_FILE="${HOME:-/home/claude}/.local/state/kordinate/tmux-layout.json"

# No saved layout — first boot or data cleared
if [ ! -f "$LAYOUT_FILE" ]; then
  echo "tmux-restore: no saved layout found, skipping"
  exit 0
fi

# Validate layout is not stale (older than 7 days)
if [ "$(find "$LAYOUT_FILE" -mtime +7 2>/dev/null)" ]; then
  echo "tmux-restore: layout older than 7 days, skipping (stale)"
  exit 0
fi

# Skip if tmux sessions already exist (someone connected before restore ran)
if tmux list-sessions &>/dev/null; then
  echo "tmux-restore: tmux sessions already exist, skipping"
  exit 0
fi

# Parse layout and create sessions/windows
python3 -c "
import json, subprocess, os

with open('$LAYOUT_FILE') as f:
    layout = json.load(f)

count = 0
for session in layout.get('sessions', []):
    name = session['name']
    windows = session.get('windows', [])
    if not windows:
        continue

    # Validate first window path exists
    first_path = windows[0].get('path', os.path.expanduser('~'))
    if not os.path.isdir(first_path):
        first_path = os.path.expanduser('~')

    # Create session with first window
    first_name = windows[0].get('name', '')
    cmd = ['tmux', 'new-session', '-d', '-s', name, '-c', first_path, '-x', '200', '-y', '50']
    if first_name:
        cmd.extend(['-n', first_name])
    subprocess.run(cmd, check=False)

    # Create remaining windows
    for win in windows[1:]:
        path = win.get('path', os.path.expanduser('~'))
        if not os.path.isdir(path):
            path = os.path.expanduser('~')
        win_name = win.get('name', '')
        cmd = ['tmux', 'new-window', '-t', f'={name}', '-c', path]
        if win_name:
            cmd.extend(['-n', win_name])
        subprocess.run(cmd, check=False)

    # Select window 0 in each session
    subprocess.run(['tmux', 'select-window', '-t', f'{name}:0'], check=False)
    count += 1

print(f'tmux-restore: restored {count} sessions')
" || {
  echo "tmux-restore: failed to parse layout, starting clean"
  exit 0
}
