# Kordinate Centralized Configuration
# All cluster IPs, ports, hostnames, and service endpoints in one place.
# Referenced by deploy configs, MCP servers, monitoring, and documentation.
#
# Copy to config.yaml and fill in your values.
# Clusters are discovered dynamically — add as many as you need.

clusters:
  # Primary cluster — add manifests.master to mark as the workstation cluster.
  mycluster:
    name: mycluster
    description: ""
    tailscale_ip:               # Tailscale IP for remote access
    lan_network:                # e.g. 10.0.0.0/24
    gateway_lan_ip:             # LAN IP of the gateway node
    nodes: []                   # List of node IPs
    namespaces: [dev, test, prod, monitor]
    manifests:
      master: agents/deployer/manifests/master       # workstation cluster marker
      gateway: agents/deployer/manifests/gateway
      bootstrap: agents/deployer/manifests/bootstrap
      platform: profile/additions
    workloads: []               # Names of workloads deployed here
    services:
      postgres:
        port:
        user:
        database:
      redis:
        port:
      metrics:
        port:
      logs:
        port:
      grafana:
        port:
        namespace: master
      registry:
        port:
        host:                   # Registry node IP
        url:                    # host:port for docker push/pull

  # Optional second cluster — remove this block if you only have one.
  # secondcluster:
  #   name: secondcluster
  #   description: ""
  #   tailscale_ip:
  #   lan_network:
  #   gateway_lan_ip:
  #   nodes: []
  #   namespaces: [dev, test, prod, monitor]
  #   manifests:
  #     gateway: agents/deployer/manifests/gateway
  #     bootstrap: agents/deployer/manifests/bootstrap
  #     platform: profile/additions
  #   workloads: []
  #   services:
  #     postgres:
  #       port:
  #       user:
  #       database:
  #     redis:
  #       port:
  #     metrics:
  #       port:
  #     logs:
  #       port:
  #     registry:
  #       port:
  #       host:
  #       url:

network:
  tailnet:                      # e.g. tailXXXXXX.ts.net
  grafana_public:               # Public domain for Grafana (if exposed)

cloudflare:
  account_id:
  tunnel_id:
  tunnel_name:
  domains: []
