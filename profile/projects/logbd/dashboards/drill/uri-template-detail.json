  "panels": [
    {
      "datasource": {
        "type": "influxdata-flightsql-datasource",
        "uid": "flightsql"
      },
      "description": "Overview of the selected URI template",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "uri_template"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 500
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traffic_spam_ratio"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.3
                    },
                    {
                      "color": "red",
                      "value": 0.7
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traffic"
            },
            "properties": [
              {
                "id": "unit",
                "value": "locale"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "spam_traffic"
            },
            "properties": [
              {
                "id": "unit",
                "value": "locale"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "centrality"
            },
            "properties": [
              {
                "id": "unit",
                "value": "sci"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdata-flightsql-datasource",
            "uid": "flightsql"
          },
          "format": "table",
          "queryText": "SELECT b.uri_template, b.scheme, b.host, b.host_fingerprint, b.format_type, b.traffic, b.spam_traffic, ROUND(d.traffic_spam_ratio, 3) AS traffic_spam_ratio, d.centrality, d.neighbor_count, ROUND(d.randomness, 3) AS randomness, ROUND(d.reuse_breadth, 1) AS reuse_breadth, d.is_shortlink, ROUND((CAST(epoch(CURRENT_TIMESTAMP) AS UINTEGER) - b.first_seen_at) / 86400.0, 1) AS days_since_first_seen FROM base_uri.base_uri_template b LEFT JOIN derived_uri_template.derived_uri_template d ON b.uri_template = d.uri_template WHERE b.uri_template = '${uri_template}'",
          "refId": "A"
        }
      ],
      "title": "Template Summary",
      "type": "table"
    },
    {
