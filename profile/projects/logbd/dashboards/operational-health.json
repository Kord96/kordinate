            "uid": "${prometheus}"
          },
          "expr": "max by (check) (pipeline_status{component=\"sentinel\", namespace=~\"$namespace\", check=\"dependencies\"})",
          "legendFormat": "Dependencies",
          "refId": "E"
        }
      ],
      "maxDataPoints": 100,
      "interval": "1m"
    },
