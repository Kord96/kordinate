{
  "uid": "operational-health",
  "title": "Operational Health",
  "editable": true,
  "schemaVersion": 39,
  "tags": [
    "pipeline",
    "monitor"
  ],
  "links": [
    {
      "type": "link",
      "title": "Overview",
      "icon": "home",
      "url": "/d/overview/",
      "includeVars": true,
      "keepTime": true
    },
    {
      "type": "link",
      "title": "Operational Detail",
      "icon": "dashboard",
      "url": "/d/operational-detail/",
      "includeVars": true,
      "keepTime": true
    },
    {
      "type": "link",
      "title": "Physical Resources",
      "icon": "dashboard",
      "url": "/d/physical-resources/",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "prod",
          "value": "prod"
        },
        "definition": "label_values(up, namespace)",
        "hide": 0,
        "includeAll": true,
        "multi": false,
        "name": "namespace",
        "options": [],
        "query": {
          "query": "label_values(up, namespace)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "regex": "/^(dev|test|prod)$/",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "selected": true,
          "text": "Loki",
          "value": "loki"
        },
        "hide": 2,
        "includeAll": false,
        "label": "Loki",
        "multi": false,
        "name": "loki",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {
          "selected": true,
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 2,
        "includeAll": false,
        "label": "Prometheus",
        "multi": false,
        "name": "prometheus",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "state-timeline",
      "title": "Section Health",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "dark-red",
                  "index": 0,
                  "text": "FAIL"
                },
                "1": {
                  "color": "dark-yellow",
                  "index": 1,
                  "text": "WARNING"
                },
                "2": {
                  "color": "dark-green",
                  "index": 2,
                  "text": "OK"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-red",
                "value": null
              },
              {
                "color": "dark-yellow",
                "value": 1
              },
              {
                "color": "dark-green",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 70,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 20,
        "x": 0,
        "y": 0
      },
      "options": {
        "showValue": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        },
        "mergeValues": true,
        "alignValue": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "max by (check) (pipeline_status{component=\"sentinel\", namespace=~\"$namespace\", check=\"ingestion\"})",
          "legendFormat": "Ingestion",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "max by (check) (pipeline_status{component=\"sentinel\", namespace=~\"$namespace\", check=\"processing\"})",
          "legendFormat": "Processing",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "max by (check) (pipeline_status{component=\"sentinel\", namespace=~\"$namespace\", check=\"enrichment\"})",
