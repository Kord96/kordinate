[
  {
    "op": "add",
    "path": "/spec/template/spec/volumes/-",
    "value": { "name": "dashboards", "emptyDir": {} }
  },
  {
    "op": "add",
    "path": "/spec/template/spec/volumes/-",
    "value": { "name": "db-logbd", "configMap": { "name": "grafana-db-logbd", "optional": true } }
  },
  {
    "op": "add",
    "path": "/spec/template/spec/volumes/-",
    "value": { "name": "db-logbd-drill", "configMap": { "name": "grafana-db-logbd-drill", "optional": true } }
  },
  {
    "op": "add",
    "path": "/spec/template/spec/volumes/-",
    "value": { "name": "db-infra", "configMap": { "name": "grafana-db-infra", "optional": true } }
  },
  {
    "op": "add",
    "path": "/spec/template/spec/containers/0/volumeMounts/-",
    "value": { "name": "dashboards", "mountPath": "/dashboards" }
  },
  {
    "op": "add",
    "path": "/spec/template/spec/initContainers/-",
    "value": {
      "name": "copy-dashboards",
      "image": "busybox:1.36",
      "command": ["/bin/sh", "-c"],
      "args": [
        "mkdir -p /dashboards/logbd/Drill /dashboards/infra\n[ -d /tmp/cm-logbd ] && cp /tmp/cm-logbd/*.json /dashboards/logbd/ 2>/dev/null || true\n[ -d /tmp/cm-logbd-drill ] && cp /tmp/cm-logbd-drill/*.json /dashboards/logbd/Drill/ 2>/dev/null || true\n[ -d /tmp/cm-infra ] && cp /tmp/cm-infra/*.json /dashboards/infra/ 2>/dev/null || true\necho \"Copied $(find /dashboards -name '*.json' | wc -l) dashboards total\""
      ],
      "volumeMounts": [
        { "name": "dashboards", "mountPath": "/dashboards" },
        { "name": "db-logbd", "mountPath": "/tmp/cm-logbd" },
        { "name": "db-logbd-drill", "mountPath": "/tmp/cm-logbd-drill" },
        { "name": "db-infra", "mountPath": "/tmp/cm-infra" }
      ]
    }
  }
]
