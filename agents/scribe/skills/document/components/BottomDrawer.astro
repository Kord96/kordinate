---
/**
 * Bottom drawer with tabbed content.
 * Tabs: Summary | Observations | Detail | Terminal
 *
 * - Summary: story summary prose + rationale cards
 * - Observations: observation cards for the active story
 * - Detail: node detail (activates on node click from canvas)
 * - Terminal: "talk to this architecture" (placeholder)
 *
 * Controlled by JS: the parent page calls updateDrawer(story, node) to populate.
 */
---

<div id="bottom-drawer" class="drawer-closed">
  <div class="drawer-handle" id="drawer-handle">
    <div class="handle-bar"></div>
  </div>
  <div class="drawer-tabs">
    <button class="drawer-tab active" data-drawer-tab="summary">Summary</button>
    <button class="drawer-tab" data-drawer-tab="observations">Observations</button>
    <button class="drawer-tab" data-drawer-tab="detail">Detail</button>
    <button class="drawer-tab" data-drawer-tab="terminal">Terminal</button>
    <button class="drawer-close" id="drawer-close">&times;</button>
  </div>
  <div class="drawer-body">
    <div class="drawer-panel active" id="dp-summary">
      <div id="dp-summary-content"></div>
    </div>
    <div class="drawer-panel" id="dp-observations">
      <div id="dp-observations-content"></div>
    </div>
    <div class="drawer-panel" id="dp-detail">
      <div id="dp-detail-header">
        <span id="dp-detail-name"></span>
        <span id="dp-detail-type-badge"></span>
      </div>
      <div id="dp-detail-content"></div>
    </div>
    <div class="drawer-panel" id="dp-terminal">
      <div class="terminal-body">
        <p class="terminal-welcome">Talk to this project's architecture. Ask questions, explore flows, understand decisions.</p>
        <div class="terminal-input-area">
          <span class="terminal-prompt">$</span>
          <input type="text" id="terminal-input" placeholder="Coming soon..." disabled />
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #bottom-drawer {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1010;
    background: var(--bg-secondary, #1e293b);
    border-top: 1px solid var(--border, #475569);
    transition: transform 0.25s ease;
    max-height: 45vh;
    display: flex;
    flex-direction: column;
  }
  #bottom-drawer.drawer-closed {
    transform: translateY(calc(100% - 2px));
  }
  #bottom-drawer.drawer-open {
    transform: translateY(0);
  }

  .drawer-handle {
    display: flex;
    justify-content: center;
    padding: 6px 0 2px;
    cursor: ns-resize;
  }
  .handle-bar {
    width: 36px;
    height: 4px;
    border-radius: 2px;
    background: var(--border, #475569);
  }

  .drawer-tabs {
    display: flex;
    border-bottom: 1px solid var(--border, #475569);
    padding: 0 1rem;
    gap: 0;
  }
  .drawer-tab {
    padding: 0.4rem 0.75rem;
    background: none;
    border: none;
    color: var(--text-muted, #64748b);
    font-size: 0.8rem;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  .drawer-tab:hover {
    color: var(--text-secondary, #94a3b8);
  }
  .drawer-tab.active {
    color: var(--text-primary, #f1f5f9);
    border-bottom-color: var(--accent, #3b82f6);
  }
  .drawer-close {
    margin-left: auto;
    background: none;
    border: none;
    color: var(--text-muted, #64748b);
    font-size: 1.2rem;
    cursor: pointer;
    padding: 0.3rem 0.5rem;
  }
  .drawer-close:hover { color: var(--text-primary, #f1f5f9); }

  .drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 0.75rem 1rem;
  }
  .drawer-panel {
    display: none;
  }
  .drawer-panel.active {
    display: block;
  }

  /* Detail panel */
  #dp-detail-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  #dp-detail-name {
    font-weight: 600;
    font-size: 1rem;
  }
  #dp-detail-type-badge {
    font-size: 0.7rem;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    display: none;
  }

  /* Terminal */
  .terminal-body {
    font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
    font-size: 0.85rem;
  }
  .terminal-welcome {
    color: var(--text-muted, #64748b);
    margin-bottom: 1rem;
  }
  .terminal-input-area {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .terminal-prompt {
    color: var(--accent, #3b82f6);
    font-weight: bold;
  }
  #terminal-input {
    flex: 1;
    background: var(--bg-primary, #0f172a);
    border: 1px solid var(--border, #475569);
    border-radius: 4px;
    padding: 0.4rem 0.6rem;
    color: var(--text-primary, #f1f5f9);
    font-family: inherit;
    font-size: inherit;
  }

  /* Node ref styling in drawer */
  .drawer-body :global(.node-ref) {
    color: #7b68ee;
    cursor: pointer;
    font-weight: 500;
    border-bottom: 1px dotted rgba(123,104,238,0.4);
  }
  .drawer-body :global(.node-ref:hover) {
    color: #9d8af7;
  }

  /* Detail rows */
  .drawer-body :global(.detail-row) {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    padding: 0.2rem 0;
    font-size: 0.85rem;
  }
  .drawer-body :global(.detail-label) {
    color: var(--text-muted, #64748b);
    min-width: 5rem;
    font-size: 0.8rem;
  }
  .drawer-body :global(.detail-badge) {
    font-size: 0.7rem;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
  }
</style>

<script is:inline>
(function() {
  var drawer = document.getElementById('bottom-drawer');
  var tabs = drawer.querySelectorAll('.drawer-tab');
  var panels = drawer.querySelectorAll('.drawer-panel');

  // Tab switching
  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      tabs.forEach(function(t) { t.classList.remove('active'); });
      panels.forEach(function(p) { p.classList.remove('active'); });
      tab.classList.add('active');
      var panel = document.getElementById('dp-' + tab.dataset.drawerTab);
      if (panel) panel.classList.add('active');
    });
  });

  // Close button
  document.getElementById('drawer-close').addEventListener('click', function() {
    drawer.classList.remove('drawer-open');
    drawer.classList.add('drawer-closed');
  });

  // Handle drag (click to toggle for now)
  document.getElementById('drawer-handle').addEventListener('click', function() {
    drawer.classList.toggle('drawer-open');
    drawer.classList.toggle('drawer-closed');
  });

  // Global API for other components to open drawer
  window.openDrawer = function(tabName) {
    drawer.classList.remove('drawer-closed');
    drawer.classList.add('drawer-open');
    if (tabName) {
      tabs.forEach(function(t) { t.classList.toggle('active', t.dataset.drawerTab === tabName); });
      panels.forEach(function(p) { p.classList.toggle('active', p.id === 'dp-' + tabName); });
    }
  };

  window.updateDrawerSummary = function(html) {
    document.getElementById('dp-summary-content').innerHTML = html;
  };

  window.updateDrawerObservations = function(html) {
    document.getElementById('dp-observations-content').innerHTML = html;
  };

  window.updateDrawerDetail = function(name, typeBadge, html) {
    document.getElementById('dp-detail-name').textContent = name;
    var badge = document.getElementById('dp-detail-type-badge');
    if (typeBadge) { badge.textContent = typeBadge.text; badge.style.cssText = typeBadge.style + ';display:inline-block'; }
    else { badge.style.display = 'none'; }
    document.getElementById('dp-detail-content').innerHTML = html;
    window.openDrawer('detail');
  };
})();
</script>
