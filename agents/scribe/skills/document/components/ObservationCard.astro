---
/**
 * Renders a single observation as a compact card.
 * - With snippet: evidence card (finding + code + confidence badge)
 * - Without snippet: compact card (finding + file:line + badge)
 * - Gap with recommendation: warning card with action
 */
interface Props {
  finding: string;
  confidence: 'high' | 'medium' | 'low';
  component?: string;
  evidence?: {
    file?: string;
    lines?: number[];
    snippet?: string;
  };
  tags?: string[];
  recommendation?: string;
  type?: string;
}

const { finding, confidence, component, evidence, tags, recommendation, type } = Astro.props;

const isGap = type === 'gap' || !!recommendation;
const hasSnippet = evidence?.snippet;

const confidenceStyle = {
  high:   { bg: 'rgba(34,197,94,0.15)', color: '#22c55e', border: '#22c55e' },
  medium: { bg: 'transparent', color: '#f59e0b', border: '#f59e0b' },
  low:    { bg: 'transparent', color: '#64748b', border: '#64748b' },
}[confidence] || { bg: 'transparent', color: '#64748b', border: '#64748b' };

const cardClass = isGap ? 'obs-card obs-warning' : 'obs-card';
---

<div class={cardClass}>
  <div class="obs-header">
    <span class="obs-finding">{finding}</span>
    <span class="obs-badge" style={`background:${confidenceStyle.bg};color:${confidenceStyle.color};border:1px solid ${confidenceStyle.border}`}>
      {confidence}
    </span>
  </div>
  {evidence?.file && (
    <div class="obs-file">
      <code>{evidence.file}{evidence.lines ? `:${evidence.lines[0]}` : ''}</code>
      {component && <span class="obs-component">{component}</span>}
    </div>
  )}
  {hasSnippet && (
    <pre class="obs-snippet"><code>{evidence!.snippet}</code></pre>
  )}
  {recommendation && (
    <div class="obs-recommendation">→ {recommendation}</div>
  )}
  {tags && tags.length > 0 && (
    <div class="obs-tags">
      {tags.map(t => <span class="obs-tag">{t}</span>)}
    </div>
  )}
</div>

<style>
  .obs-card {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border, #475569);
    border-radius: 6px;
    background: var(--bg-secondary, #1e293b);
    margin-bottom: 0.5rem;
    font-size: 0.85rem;
  }
  .obs-warning {
    border-left: 3px solid #f59e0b;
  }
  .obs-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .obs-finding {
    color: var(--text-primary, #f1f5f9);
    line-height: 1.4;
  }
  .obs-badge {
    font-size: 0.7rem;
    padding: 0.1rem 0.4rem;
    border-radius: 9999px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .obs-file {
    margin-top: 0.25rem;
    color: var(--text-muted, #64748b);
    font-size: 0.8rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .obs-file code {
    font-size: 0.75rem;
  }
  .obs-component {
    color: var(--text-secondary, #94a3b8);
  }
  .obs-snippet {
    margin: 0.35rem 0 0;
    padding: 0.4rem 0.6rem;
    background: var(--bg-primary, #0f172a);
    border-radius: 4px;
    overflow-x: auto;
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .obs-recommendation {
    margin-top: 0.25rem;
    color: #f59e0b;
    font-size: 0.8rem;
  }
  .obs-tags {
    margin-top: 0.25rem;
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
  }
  .obs-tag {
    font-size: 0.65rem;
    padding: 0.05rem 0.35rem;
    border-radius: 4px;
    background: rgba(255,255,255,0.05);
    color: var(--text-muted, #64748b);
  }
</style>
