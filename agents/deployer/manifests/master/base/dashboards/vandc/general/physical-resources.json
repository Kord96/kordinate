              {
                "id": "displayName",
                "value": "Arch"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "instance"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "job"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "__name__"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "pod"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "app"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "component"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "namespace"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "count by (node, cluster) (count by (node, cluster, cpu) (node_cpu_seconds_total{cluster=~\"$cluster\", component=\"node-exporter\", mode=\"idle\"}))",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "max by (node, cluster) (node_memory_MemTotal_bytes{cluster=~\"$cluster\", component=\"node-exporter\"})",
          "legendFormat": "",
          "refId": "B",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "max by (node, cluster) (node_filesystem_size_bytes{cluster=~\"$cluster\", component=\"node-exporter\", mountpoint=\"/\"})",
          "legendFormat": "",
          "refId": "C",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "instance": true,
              "job": true,
              "__name__": true,
              "pod": true,
              "app": true,
              "component": true,
              "namespace": true,
              "boot_id": true,
              "machine_id": true,
              "system_uuid": true,
              "domainname": true,
              "nodename": true,
              "release": true,
              "sysname": true,
              "version": true,
              "cpu": true,
              "mode": true,
              "device": true,
              "fstype": true,
              "mountpoint": true
            },
            "indexByName": {
              "cluster": 0,
              "node": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4
            },
            "renameByName": {
              "cluster": "Cluster",
              "node": "Node",
              "Value #A": "CPU Cores",
              "Value #B": "RAM",
              "Value #C": "Root Disk"
            }
          }
        }
      ]
    },
    {
