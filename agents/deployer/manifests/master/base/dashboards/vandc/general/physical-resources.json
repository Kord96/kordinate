{
  "uid": "physical-resources",
  "title": "Physical Resources",
  "editable": true,
  "schemaVersion": 39,
  "tags": [
    "infrastructure",
    "monitor"
  ],
  "links": [
    {
      "type": "link",
      "title": "Operational Health",
      "icon": "dashboard",
      "url": "/d/operational-health/",
      "includeVars": true,
      "keepTime": true
    },
    {
      "type": "dashboards",
      "title": "Apps",
      "icon": "apps",
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "business"
      ],
      "targetBlank": false
    }
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "prod",
          "value": "prod"
        },
        "definition": "label_values(up, namespace)",
        "hide": 0,
        "includeAll": true,
        "multi": false,
        "name": "namespace",
        "options": [],
        "query": {
          "query": "label_values(up, namespace)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "regex": "/^(dev|test|prod)$/",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": ".*",
        "label": "Cluster",
        "multi": false,
        "name": "cluster",
        "options": [],
        "query": {
          "query": "label_values(up, cluster)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "selected": true,
          "text": "Loki",
          "value": "loki"
        },
        "hide": 2,
        "includeAll": false,
        "label": "Loki",
        "multi": false,
        "name": "loki",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {
          "selected": true,
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 2,
        "includeAll": false,
        "label": "Prometheus",
        "multi": false,
        "name": "prometheus",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "state-timeline",
      "title": "Infrastructure Health",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "y": 0,
        "x": 0,
        "w": 18,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "green",
            "mode": "fixed"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "dark-red",
                  "index": 0,
                  "text": "FAIL"
                },
                "1": {
                  "color": "dark-yellow",
                  "index": 1,
                  "text": "WARNING"
                },
                "2": {
                  "color": "dark-green",
                  "index": 2,
                  "text": "OK"
                }
              },
              "type": "value"
            }
          ]
        }
      },
      "options": {
        "alignValue": "center",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "mergeValues": true,
        "rowHeight": 0.85,
        "showValue": "never",
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "(max(pipeline_pvc_used_bytes{cluster=~\"$cluster\", namespace=~\"$namespace\"} / pipeline_pvc_capacity_bytes{cluster=~\"$cluster\", namespace=~\"$namespace\"}) < bool 0.95) + (max(pipeline_pvc_used_bytes{cluster=~\"$cluster\", namespace=~\"$namespace\"} / pipeline_pvc_capacity_bytes{cluster=~\"$cluster\", namespace=~\"$namespace\"}) < bool 0.8)",
          "legendFormat": "PVC Disk",
          "refId": "A"
        },
        {
          "expr": "min(up{cluster=~\"$cluster\", component=\"kafka\", namespace=~\"$namespace\"}) * 2",
          "legendFormat": "Kafka",
          "refId": "B"
        },
        {
          "expr": "(max(1 - avg by(node)(rate(node_cpu_seconds_total{cluster=~\"$cluster\", component=\"node-exporter\",mode=\"idle\"}[5m]))) < bool 0.95) + (max(1 - avg by(node)(rate(node_cpu_seconds_total{cluster=~\"$cluster\", component=\"node-exporter\",mode=\"idle\"}[5m]))) < bool 0.80)",
          "legendFormat": "Node CPU",
          "refId": "C"
        },
        {
          "expr": "(max(1 - node_memory_MemAvailable_bytes{cluster=~\"$cluster\", component=\"node-exporter\"} / node_memory_MemTotal_bytes{cluster=~\"$cluster\", component=\"node-exporter\"}) < bool 0.95) + (max(1 - node_memory_MemAvailable_bytes{cluster=~\"$cluster\", component=\"node-exporter\"} / node_memory_MemTotal_bytes{cluster=~\"$cluster\", component=\"node-exporter\"}) < bool 0.85)",
          "legendFormat": "Node Memory",
          "refId": "D"
        },
        {
          "expr": "(max(1 - node_filesystem_avail_bytes{cluster=~\"$cluster\", component=\"node-exporter\",mountpoint=\"/\"} / node_filesystem_size_bytes{cluster=~\"$cluster\", component=\"node-exporter\",mountpoint=\"/\"}) < bool 0.90) + (max(1 - node_filesystem_avail_bytes{cluster=~\"$cluster\", component=\"node-exporter\",mountpoint=\"/\"} / node_filesystem_size_bytes{cluster=~\"$cluster\", component=\"node-exporter\",mountpoint=\"/\"}) < bool 0.80)",
          "legendFormat": "Node Disk",
          "refId": "E"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Physical Health",
      "description": "Minimum of infrastructure checks (PVC Disk, Kafka, Node CPU, Node Memory, Node Disk)",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "y": 0,
        "x": 18,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "dark-red",
                  "index": 0,
                  "text": "FAIL"
                },
                "1": {
                  "color": "dark-yellow",
                  "index": 1,
                  "text": "DEGRADED"
                },
                "2": {
                  "color": "dark-green",
                  "index": 2,
                  "text": "HEALTHY"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "min(((max(pipeline_pvc_used_bytes{cluster=~\"$cluster\", namespace=~\"$namespace\"} / pipeline_pvc_capacity_bytes{cluster=~\"$cluster\", namespace=~\"$namespace\"}) < bool 0.95) + (max(pipeline_pvc_used_bytes{cluster=~\"$cluster\", namespace=~\"$namespace\"} / pipeline_pvc_capacity_bytes{cluster=~\"$cluster\", namespace=~\"$namespace\"}) < bool 0.8)) or (min(up{cluster=~\"$cluster\", component=\"kafka\", namespace=~\"$namespace\"}) * 2) or ((max(1 - avg by(node)(rate(node_cpu_seconds_total{cluster=~\"$cluster\", component=\"node-exporter\",mode=\"idle\"}[5m]))) < bool 0.95) + (max(1 - avg by(node)(rate(node_cpu_seconds_total{cluster=~\"$cluster\", component=\"node-exporter\",mode=\"idle\"}[5m]))) < bool 0.80)) or ((max(1 - node_memory_MemAvailable_bytes{cluster=~\"$cluster\", component=\"node-exporter\"} / node_memory_MemTotal_bytes{cluster=~\"$cluster\", component=\"node-exporter\"}) < bool 0.95) + (max(1 - node_memory_MemAvailable_bytes{cluster=~\"$cluster\", component=\"node-exporter\"} / node_memory_MemTotal_bytes{cluster=~\"$cluster\", component=\"node-exporter\"}) < bool 0.85)) or ((max(1 - node_filesystem_avail_bytes{cluster=~\"$cluster\", component=\"node-exporter\",mountpoint=\"/\"} / node_filesystem_size_bytes{cluster=~\"$cluster\", component=\"node-exporter\",mountpoint=\"/\"}) < bool 0.90) + (max(1 - node_filesystem_avail_bytes{cluster=~\"$cluster\", component=\"node-exporter\",mountpoint=\"/\"} / node_filesystem_size_bytes{cluster=~\"$cluster\", component=\"node-exporter\",mountpoint=\"/\"}) < bool 0.80)))",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "row",
      "title": "Cluster Overview",
      "collapsed": false,
      "gridPos": {
        "y": 5,
        "x": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 100,
      "type": "table",
      "title": "Node Inventory",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "y": 6,
        "x": 0,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "unit",
