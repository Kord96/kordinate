              "options": "element"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 600
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traffic_spam_ratio"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.3
                    },
                    {
                      "color": "red",
                      "value": 0.7
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traffic"
            },
            "properties": [
              {
                "id": "unit",
                "value": "locale"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "spam_traffic"
            },
            "properties": [
              {
                "id": "unit",
                "value": "locale"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdata-flightsql-datasource",
            "uid": "flightsql"
          },
          "format": "table",
          "queryText": "SELECT m.element, m.traffic, m.spam_traffic, CASE WHEN m.traffic > 0 THEN ROUND(m.spam_traffic::FLOAT / m.traffic, 3) ELSE 0 END AS traffic_spam_ratio, ROUND((CAST(epoch(CURRENT_TIMESTAMP) AS UINTEGER) - m.first_seen_at) / 86400.0, 1) AS days_since_first_seen FROM base_cluster_member.base_cluster_member m WHERE m.cluster_key = '${cluster_key}' ORDER BY m.traffic DESC LIMIT 200",
          "refId": "A"
        }
      ],
      "title": "Members",
      "type": "table"
    }
