{
  "env": {
    "WORKSTATION_HOME": "$HOME",
    "KORD_SOURCE_ROOT": "$HOME/repos/kordinate",
    "KORD_LOCAL_STATE": "$HOME/.local/share/kordinate",
    "KORD_LOCKS_DIR": "$HOME/.local/share/kordinate/locks",
    "KORD_WORKTREES_DIR": "$HOME/.local/share/kordinate/worktrees",
    "KORD_SESSION_STATE_DIR": "$HOME/.claude/session-state"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash|mcp__grafana",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard.sh"
          }
        ]
      }
    ]
  },
  "effortLevel": "max",
  "skipDangerousModePermissionPrompt": true
}
