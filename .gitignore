# Ephemeral / cache
cache/
sessions/
history.jsonl
telemetry/
shell-snapshots/
file-history/
plans/
backups/
session-env/
mcp-needs-auth-cache.json

# Per-project tool results and memory (large, ephemeral)
/projects/

# Plugins (can be reinstalled)
plugins/

# Agent state is session-ephemeral
agent-state/

# Claude runtime (populated by /onboard sync, not tracked)
.claude/

# Session worktrees
.worktrees/

# Secrets and credentials
.credentials.json

# Symlinks and copies (created by scribe /onboard sync)
/CLAUDE.md
/settings.json
/keybindings.json
/.mcp.json
/agents
/agent-memory
/commands
/profile

# Agent runtime state
kordinate/agents/*/deploys/

# Site-specific profile data (generated from real config by alfred)
kordinate/profile/overlays/

# CLAUDE.md copies (created by scribe /onboard sync, not tracked)
kordinate/agents/*/CLAUDE.md

# Kord session data (ephemeral, populated at runtime)
**/kords/*/data.md

# Computed hashes (regenerated by tools)
**/memory/dynamic/.hash
docs/.source-hashes/

# NFS temp files
.nfs*


# Playwright MCP artifacts
.playwright-mcp/
*.png

# MkDocs build output
site/

# Legacy
__pycache__/
.merge-lock/
tasks/
mcp-needs-auth-cache.json
