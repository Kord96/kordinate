    "arguments": "<cluster>",
    "public": true
  },
  {
    "type": "skill",
    "name": "roll",
    "agent": "charon",
    "description": "Deploy between environments (forward) or revert (backward).",
    "arguments": "<project> <source> <target> | back <project> <env>",
    "public": true
  },
  {
    "type": "skill",
    "name": "migrate",
    "agent": "charon",
