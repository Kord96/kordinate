[
  {
    "type": "skill",
    "name": "bootstrap",
    "agent": "charon",
    "description": "Set up a cluster from scratch \u2014 namespaces, storage, overlays, deploy stacks.",
    "arguments": "<cluster>",
    "public": true
  },
  {
    "type": "skill",
    "name": "roll",
    "agent": "charon",
    "description": "Deploy between environments (forward) or revert (backward).",
    "arguments": "<project> <source> <target> | back <project> <env>",
    "public": true
  },
  {
    "type": "skill",
    "name": "migrate",
    "agent": "charon",
    "description": "Move a resource to a new location.",
    "arguments": "workstation | pvc <name> <namespace>",
    "public": true
  },
  {
    "type": "skill",
    "name": "add-node",
    "agent": "charon",
    "description": "Add a worker node to an existing k3s cluster.",
    "arguments": "<node-name> <tailscale-ip>",
    "public": true
  },
  {
    "type": "guard",
    "pattern": "kubectl .*",
    "tool": "Bash",
    "validation": "charon",
    "description": "Cluster operations require charon"
  },
  {
    "type": "guard",
    "pattern": "helm .*",
    "tool": "Bash",
    "validation": "charon",
    "description": "Helm operations require charon"
  },
  {
    "type": "guard",
    "pattern": "git push .* test.*",
    "tool": "Bash",
    "validation": "charon",
    "description": "Push to test requires charon"
  },
  {
    "type": "guard",
    "pattern": "git push .* prod.*",
    "tool": "Bash",
    "validation": "charon",
    "description": "Push to prod requires charon"
  },
  {
    "type": "file",
    "path": "agents/charon/memory/scratchpad.md",
    "description": "Working notes",
    "owner": "charon",
    "preload": "none"
  }
]
