---
/**
 * Main explorer page — the interactive shell for story-based documentation.
 *
 * Layout:
 * ┌──────────────────────────────────────────────────────────┐
 * │  project name                                   [Atlas]  │
 * ├──────────────────────────────────────────────────────────┤
 * │  [Overview] [Backend] [Frontend] [Resilience]  ← journeys│
 * ├──────────┬───────────────────────────────────────────────┤
 * │ Stories  │           Main Canvas                         │
 * │ (sidebar)│  (graph / diagram / timeline for selected)    │
 * │          ├───────────────────────────────────────────────┤
 * │          │  Bottom Drawer                                │
 * │          │  [Summary] [Observations] [Detail] [Terminal] │
 * └──────────┴───────────────────────────────────────────────┘
 *
 * - Journeys = tabs (top bar)
 * - Stories = sidebar items (left)
 * - Canvas = selected story's visual blocks
 * - Drawer = selected story's text + node detail on click
 */
import BottomDrawer from './BottomDrawer.astro';

interface Props {
  project: string;
  journeys: any[];          // all journey objects
  storiesByJourney: Record<string, any[]>;  // journeyId → ordered stories
  atlas: any;
  rendering: Record<string, any>;
  repoUrl?: string;
}

const { project, journeys, storiesByJourney, atlas, rendering, repoUrl } = Astro.props;

const stats = {
  components: atlas.components?.length || 0,
  flows: atlas.data_flows?.length || 0,
  observations: Object.values(storiesByJourney).flat().reduce((n: number, s: any) => n + (s.observations?.length || 0), 0),
};

// Flatten all stories for the data blob
const allStories = Object.values(storiesByJourney).flat();
const uniqueStories = [...new Map(allStories.map((s: any) => [s.id, s])).values()];
---

<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{project} — Explorer</title>
  <script src="https://unpkg.com/cytoscape@3.30.4/dist/cytoscape.min.js" is:inline defer></script>
  <script src="https://unpkg.com/layout-base@2.0.1/layout-base.js" is:inline defer></script>
  <script src="https://unpkg.com/cose-base@2.2.0/cose-base.js" is:inline defer></script>
  <script src="https://unpkg.com/cytoscape-cose-bilkent@4.1.0/cytoscape-cose-bilkent.js" is:inline defer></script>
  <script src="https://unpkg.com/dagre@0.8.5/dist/dagre.min.js" is:inline defer></script>
  <script src="https://unpkg.com/cytoscape-dagre@2.5.0/cytoscape-dagre.js" is:inline defer></script>
  <script src="https://cdn.jsdelivr.net/npm/mermaid/dist/mermaid.min.js" is:inline defer></script>
  <style>
    :root {
      --bg-primary: #0f172a;
      --bg-secondary: #1e293b;
      --bg-tertiary: #334155;
      --text-primary: #f1f5f9;
      --text-secondary: #94a3b8;
      --text-muted: #64748b;
      --border: #475569;
      --accent: #3b82f6;
      --accent-hover: #60a5fa;
    }
    @media (prefers-color-scheme: light) {
      :root {
        --bg-primary: #ffffff;
        --bg-secondary: #f8fafc;
        --bg-tertiary: #e2e8f0;
        --text-primary: #0f172a;
        --text-secondary: #475569;
        --text-muted: #94a3b8;
        --border: #cbd5e1;
      }
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg-primary);
      color: var(--text-primary);
      overflow: hidden;
      height: 100vh;
    }

    /* === NAV BAR === */
    .nav-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.6rem 1.25rem;
      border-bottom: 1px solid var(--border);
      background: var(--bg-secondary);
      z-index: 1020;
    }
    .nav-left { display: flex; align-items: center; gap: 0.75rem; }
    .nav-project { font-size: 1.1rem; font-weight: 600; }
    .nav-stats { font-size: 0.75rem; color: var(--text-muted); }
    .nav-right { display: flex; gap: 0.75rem; align-items: center; }
    .nav-link {
      font-size: 0.8rem;
      color: var(--accent);
      text-decoration: none;
      padding: 0.25rem 0.5rem;
      border: 1px solid var(--border);
      border-radius: 5px;
    }
    .nav-link:hover { background: rgba(59,130,246,0.1); }

    /* === JOURNEY TABS === */
    .journey-tabs {
      display: flex;
      border-bottom: 1px solid var(--border);
      padding: 0 1.25rem;
      background: var(--bg-secondary);
      z-index: 1010;
    }
    .journey-tab {
      padding: 0.5rem 1rem;
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 0.85rem;
      cursor: pointer;
      border-bottom: 2px solid transparent;
      transition: color 0.15s;
    }
    .journey-tab:hover { color: var(--text-secondary); }
    .journey-tab.active {
      color: var(--text-primary);
      border-bottom-color: var(--accent);
    }

    /* === MAIN LAYOUT === */
    .main-layout {
      display: flex;
      height: calc(100vh - 90px); /* minus nav + tabs */
    }

    /* === STORY SIDEBAR === */
    .story-sidebar {
      width: 220px;
      border-right: 1px solid var(--border);
      background: var(--bg-secondary);
      overflow-y: auto;
      flex-shrink: 0;
      padding: 0.5rem 0;
    }
    .sidebar-label {
      font-size: 0.65rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      padding: 0.5rem 1rem 0.25rem;
    }
    .story-item {
      display: block;
      width: 100%;
      padding: 0.4rem 1rem;
      background: none;
      border: none;
      text-align: left;
      color: var(--text-secondary);
      font-size: 0.8rem;
      cursor: pointer;
      border-left: 3px solid transparent;
      transition: background 0.1s;
    }
    .story-item:hover {
      background: rgba(255,255,255,0.03);
      color: var(--text-primary);
    }
    .story-item.active {
      background: rgba(59,130,246,0.08);
      color: var(--text-primary);
      border-left-color: var(--accent);
    }
    .story-teaches {
      display: block;
      font-size: 0.7rem;
      color: var(--text-muted);
      margin-top: 0.1rem;
    }

    /* === CANVAS === */
    .canvas-area {
      flex: 1;
      position: relative;
      overflow: hidden;
      min-width: 0;
    }
    #main-canvas {
      width: 100%;
      height: 100%;
    }
    .canvas-empty {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100%;
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    /* === RESPONSIVE === */
    @media (max-width: 768px) {
      .story-sidebar { display: none; }
      .main-layout { height: calc(100vh - 90px); }
    }
  </style>
</head>
<body>
  <!-- NAV BAR -->
  <nav class="nav-bar">
    <div class="nav-left">
      <span class="nav-project">{project}</span>
      <span class="nav-stats">{stats.components} components · {stats.flows} flows · {stats.observations} observations</span>
    </div>
    <div class="nav-right">
      <a class="nav-link" href={`/${project}/atlas/`}>Atlas</a>
      <a class="nav-link" href={`/${project}/facts/`}>Facts</a>
      {repoUrl && <a class="nav-link" href={repoUrl} target="_blank">GitHub</a>}
    </div>
  </nav>

  <!-- JOURNEY TABS -->
  <div class="journey-tabs" id="journey-tabs">
    {journeys.map((j, i) => (
      <button class={`journey-tab ${i === 0 ? 'active' : ''}`} data-journey-id={j.id}>{j.title}</button>
    ))}
  </div>

  <!-- MAIN LAYOUT -->
  <div class="main-layout">
    <!-- STORY SIDEBAR -->
    <aside class="story-sidebar" id="story-sidebar">
      <div class="sidebar-label">Stories</div>
      {/* Populated by JS when journey tab changes */}
    </aside>

    <!-- CANVAS -->
    <div class="canvas-area">
      <div id="main-canvas">
        <div class="canvas-empty">Select a story to explore</div>
      </div>
    </div>
  </div>

  <!-- BOTTOM DRAWER -->
  <BottomDrawer />

  <!-- DATA -->
  <script id="explorer-data" type="application/json" set:html={JSON.stringify({
    project,
    journeys,
    storiesByJourney,
    stories: uniqueStories,
    atlas,
    rendering,
  })} />

  <script is:inline>
  (function() {
    'use strict';
    var DATA = JSON.parse(document.getElementById('explorer-data').textContent);
    var sidebar = document.getElementById('story-sidebar');
    var canvas = document.getElementById('main-canvas');
    var currentJourney = DATA.journeys[0]?.id;
    var currentStory = null;
    var storyMap = {};
    DATA.stories.forEach(function(s) { storyMap[s.id] = s; });

    // Atlas node lookup
    var nodeMap = {};
    (DATA.atlas.components || []).forEach(function(c) { nodeMap[c.id] = c; });
    (DATA.atlas.external_dependencies || []).forEach(function(e) { nodeMap[e.id] = e; });
    (DATA.atlas.actors || []).forEach(function(a) { nodeMap[a.id] = a; });

    var typeColors = {
      component: '#4a90d9', service: '#3498db', frontend: '#4a90d9',
      library: '#9b59b6', worker: '#2ecc71', api: '#3498db',
      external: '#e74c3c', 'external-service': '#e67e22',
      store: '#1abc9c', gateway: '#e67e22', actor: '#14b8a6',
      broker: '#f97316', config: '#c0392b', scheduler: '#6366f1'
    };

    // === JOURNEY TAB SWITCHING ===
    document.querySelectorAll('.journey-tab').forEach(function(tab) {
      tab.addEventListener('click', function() {
        document.querySelectorAll('.journey-tab').forEach(function(t) { t.classList.remove('active'); });
        tab.classList.add('active');
        currentJourney = tab.dataset.journeyId;
        buildSidebar();
      });
    });

    // === BUILD SIDEBAR ===
    function buildSidebar() {
      var stories = DATA.storiesByJourney[currentJourney] || [];
      var html = '<div class="sidebar-label">Stories</div>';
      stories.forEach(function(s) {
        html += '<button class="story-item" data-story-id="' + s.id + '">'
          + s.title
          + '<span class="story-teaches">' + (s.teaches || '') + '</span>'
          + '</button>';
      });
      sidebar.innerHTML = html;
      sidebar.querySelectorAll('.story-item').forEach(function(item) {
        item.addEventListener('click', function() {
          selectStory(item.dataset.storyId);
        });
      });
      // Auto-select first story
      if (stories.length > 0) selectStory(stories[0].id);
    }

    // === SELECT STORY ===
    function selectStory(storyId) {
      currentStory = storyMap[storyId];
      if (!currentStory) return;

      // Update sidebar active state
      sidebar.querySelectorAll('.story-item').forEach(function(item) {
        item.classList.toggle('active', item.dataset.storyId === storyId);
      });

      // Render canvas
      renderCanvas(currentStory);

      // Update drawer
      updateDrawerForStory(currentStory);
    }

    // === RENDER CANVAS ===
    function renderCanvas(story) {
      // Determine what to render based on building blocks
      var structures = story.structures || [];
      var flows = story.flows || [];

      if (structures.length > 0) {
        renderGraph(structures[0], story);
      } else if (flows.length > 0) {
        var flow = flows[0];
        if (flow.type === 'failure cascade') {
          renderFailureTimeline(flow, story);
        } else {
          renderSequenceDiagram(flow, story);
        }
      } else {
        canvas.innerHTML = '<div class="canvas-empty">This story has no visual blocks</div>';
      }
    }

    // === RENDER GRAPH ===
    function renderGraph(structure, story) {
      canvas.innerHTML = '<div id="cy-story" style="width:100%;height:100%"></div>';
      if (typeof cytoscape === 'undefined') { setTimeout(function() { renderGraph(structure, story); }, 200); return; }

      var elements = [];
      (structure.nodes || []).forEach(function(n) {
        var atlas = nodeMap[n.id] || {};
        elements.push({
          group: 'nodes',
          data: {
            id: n.id,
            label: atlas.name || n.id.replace(/-/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); }),
            nodeType: atlas.type || 'component',
            description: atlas.description || ''
          }
        });
      });
      (structure.edges || []).forEach(function(e) {
        elements.push({
          group: 'edges',
          data: { source: e.from, target: e.to, label: e.label || '' }
        });
      });

      var nodeCount = (structure.nodes || []).length;
      var layoutName = nodeCount <= 8 ? 'dagre' : 'cose-bilkent';

      var cy = cytoscape({
        container: document.getElementById('cy-story'),
        elements: elements,
        minZoom: 0.3, maxZoom: 4, wheelSensitivity: 0.3,
        style: [
          { selector: 'node', style: {
            'label': 'data(label)', 'text-valign': 'center', 'text-halign': 'center',
            'font-size': '11px', 'color': '#fff', 'text-wrap': 'wrap', 'text-max-width': '120px',
            'border-width': 1.5, 'shape': 'roundrectangle', 'padding': '10px',
            'width': 'label', 'height': 'label'
          }},
          { selector: 'node.hover', style: { 'overlay-color': '#7b68ee', 'overlay-padding': 6, 'overlay-opacity': 0.2 }},
          { selector: 'edge', style: {
            'width': 1.5, 'line-color': 'rgba(255,255,255,0.2)',
            'target-arrow-color': 'rgba(255,255,255,0.2)', 'target-arrow-shape': 'triangle',
            'curve-style': 'bezier', 'arrow-scale': 0.7,
            'label': 'data(label)', 'font-size': '9px', 'color': 'rgba(255,255,255,0.5)',
            'text-background-color': '#0f172a', 'text-background-opacity': 0.8, 'text-background-padding': '2px'
          }}
        ]
      });

      cy.nodes().forEach(function(n) {
        var c = typeColors[n.data('nodeType')] || '#4a90d9';
        n.style({ 'background-color': c, 'border-color': c });
      });

      try {
        var lo = layoutName === 'dagre'
          ? { name: 'dagre', rankDir: 'LR', nodeSep: 40, rankSep: 80 }
          : { name: 'cose-bilkent', idealEdgeLength: 120, nodeRepulsion: 8000, numIter: 1500 };
        cy.layout(lo).run();
      } catch(e) { cy.layout({ name: 'grid', padding: 30 }).run(); }
      cy.fit(undefined, 30);

      cy.on('mouseover', 'node', function(e) { e.target.addClass('hover'); });
      cy.on('mouseout', 'node', function(e) { e.target.removeClass('hover'); });
      cy.on('tap', 'node', function(e) {
        var id = e.target.data('id');
        var n = nodeMap[id];
        if (n) showNodeDetail(n);
      });
    }

    // === RENDER SEQUENCE DIAGRAM ===
    function renderSequenceDiagram(flow, story) {
      var lines = ['sequenceDiagram', '    autonumber'];
      (flow.steps || []).forEach(function(step) {
        var label = (step.action || step.effect || '').substring(0, 60);
        if (step.to) lines.push('    ' + step.node + '->>' + step.to + ': ' + label);
      });
      var dsl = lines.join('\n');
      canvas.innerHTML = '<div style="padding:1.5rem;overflow:auto;height:100%"><div class="mermaid-target"></div></div>';
      if (typeof mermaid === 'undefined') { setTimeout(function() { renderSequenceDiagram(flow, story); }, 200); return; }
      mermaid.initialize({ startOnLoad: false, theme: 'dark', themeVariables: {
        primaryColor: '#2a2a5e', primaryBorderColor: '#7b68ee', primaryTextColor: '#ddd',
        lineColor: '#7b68ee', sequenceNumberColor: '#1a1a2e'
      }});
      mermaid.render('mermaid-canvas', dsl).then(function(r) {
        canvas.querySelector('.mermaid-target').innerHTML = r.svg;
      }).catch(function() {
        canvas.querySelector('.mermaid-target').innerHTML = '<pre>' + dsl + '</pre>';
      });
    }

    // === RENDER FAILURE TIMELINE ===
    function renderFailureTimeline(flow, story) {
      var sevColors = { critical: '#ef4444', high: '#f97316', medium: '#f59e0b', low: '#22c55e' };
      var color = sevColors[flow.severity] || '#64748b';
      var html = '<div style="padding:1.5rem;overflow:auto;height:100%">';
      html += '<div style="border:1px solid var(--border);border-left:3px solid ' + color + ';border-radius:8px;background:var(--bg-secondary);padding:1rem;max-width:700px;margin:0 auto">';
      html += '<div style="display:flex;justify-content:space-between;align-items:center"><strong>' + (flow.title || flow.trigger || '') + '</strong><span style="font-size:0.7rem;padding:0.1rem 0.4rem;border-radius:9999px;background:' + color + '33;color:' + color + '">' + (flow.severity || '') + '</span></div>';
      if (flow.trigger) html += '<div style="color:var(--text-secondary);font-size:0.85rem;margin:0.3rem 0">▸ ' + flow.trigger + '</div>';
      (flow.steps || []).forEach(function(s, i) {
        html += '<div style="display:flex;gap:0.4rem;font-size:0.85rem;padding:0.15rem 0"><span style="color:var(--text-muted);min-width:1.2rem">' + (i+1) + '</span><span class="node-ref" data-node-id="' + s.node + '" style="color:#7b68ee;cursor:pointer">' + s.node + '</span><span style="color:var(--text-secondary)">— ' + (s.effect || s.action || '') + '</span></div>';
      });
      var det = (flow.detection || []).join(', ');
      var rec = (flow.recovery || []).join(', ');
      html += '<div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.5rem">detection: ' + (det === 'none' ? '<span style="color:#ef4444">none</span>' : det) + ' · recovery: ' + (rec === 'none' ? '<span style="color:#ef4444">none</span>' : rec) + '</div>';
      html += '</div></div>';
      canvas.innerHTML = html;

      // Bind node-ref clicks
      canvas.querySelectorAll('.node-ref').forEach(function(ref) {
        ref.addEventListener('click', function() {
          var n = nodeMap[ref.dataset.nodeId];
          if (n) showNodeDetail(n);
        });
      });
    }

    // === DRAWER: STORY CONTENT ===
    function updateDrawerForStory(story) {
      // Summary tab
      var summaryHtml = '<div style="font-size:0.9rem;line-height:1.6;color:var(--text-secondary)">' + parseSummary(story.summary || '') + '</div>';
      if (story.rationale && story.rationale.length > 0) {
        summaryHtml += '<div style="margin-top:0.75rem">';
        story.rationale.forEach(function(r) {
          summaryHtml += '<div style="padding:0.5rem 0.75rem;border:1px solid var(--border);border-left:3px solid #3b82f6;border-radius:6px;background:var(--bg-secondary);margin-bottom:0.5rem;font-size:0.85rem">';
          summaryHtml += '<div style="font-weight:500">ℹ ' + (r.decision || '') + '</div>';
          if (r.context) summaryHtml += '<div style="color:var(--text-secondary);font-size:0.8rem;margin-top:0.1rem">' + r.context + '</div>';
          if (r.trade_offs) summaryHtml += '<div style="color:var(--text-muted);font-size:0.8rem;margin-top:0.1rem">↔ ' + r.trade_offs + '</div>';
          summaryHtml += '</div>';
        });
        summaryHtml += '</div>';
      }
      window.updateDrawerSummary(summaryHtml);

      // Observations tab
      var obsHtml = '';
      (story.observations || []).forEach(function(obs) {
        var confStyle = obs.confidence === 'high' ? 'background:rgba(34,197,94,0.15);color:#22c55e;border:1px solid #22c55e' : obs.confidence === 'medium' ? 'color:#f59e0b;border:1px solid #f59e0b' : 'color:#64748b;border:1px solid #64748b';
        var isGap = obs.recommendation;
        obsHtml += '<div style="padding:0.5rem 0.75rem;border:1px solid var(--border);' + (isGap ? 'border-left:3px solid #f59e0b;' : '') + 'border-radius:6px;background:var(--bg-secondary);margin-bottom:0.5rem;font-size:0.85rem">';
        obsHtml += '<div style="display:flex;justify-content:space-between;gap:0.5rem"><span>' + (obs.finding || '') + '</span><span style="font-size:0.7rem;padding:0.1rem 0.4rem;border-radius:9999px;white-space:nowrap;' + confStyle + '">' + (obs.confidence || '') + '</span></div>';
        if (obs.evidence && obs.evidence.file) obsHtml += '<div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.15rem"><code>' + obs.evidence.file + (obs.evidence.lines ? ':' + obs.evidence.lines[0] : '') + '</code></div>';
        if (obs.evidence && obs.evidence.snippet) obsHtml += '<pre style="margin:0.25rem 0 0;padding:0.3rem 0.5rem;background:var(--bg-primary);border-radius:4px;font-size:0.75rem;overflow-x:auto"><code>' + obs.evidence.snippet + '</code></pre>';
        if (obs.recommendation) obsHtml += '<div style="color:#f59e0b;font-size:0.8rem;margin-top:0.15rem">→ ' + obs.recommendation + '</div>';
        obsHtml += '</div>';
      });
      window.updateDrawerObservations(obsHtml || '<div style="color:var(--text-muted);font-size:0.85rem">No observations for this story</div>');

      // Open drawer to summary
      window.openDrawer('summary');
    }

    // === DRAWER: NODE DETAIL ===
    function showNodeDetail(node) {
      var cfg = typeColors[node.type] || '#4a90d9';
      var html = '';
      if (node.description) html += '<div class="detail-row"><span class="detail-label">Description</span><span>' + node.description + '</span></div>';
      if (node.modules && node.modules.length > 0) html += '<div class="detail-row"><span class="detail-label">File</span><code>' + node.modules[0] + '</code></div>';
      if (node.patterns && node.patterns.length > 0) {
        html += '<div class="detail-row"><span class="detail-label">Patterns</span><span>';
        node.patterns.forEach(function(p) { html += '<span class="detail-badge" style="background:rgba(123,104,238,0.15);color:#7b68ee;margin-right:0.25rem">' + p + '</span>'; });
        html += '</span></div>';
      }
      if (node.criticality) html += '<div class="detail-row"><span class="detail-label">Criticality</span><span>' + node.criticality + '</span></div>';
      if (node.resilience) {
        var flags = [];
        if (node.resilience.timeout) flags.push('timeout');
        if (node.resilience.retry) flags.push('retry');
        if (node.resilience.circuit_breaker) flags.push('circuit breaker');
        if (flags.length > 0) html += '<div class="detail-row"><span class="detail-label">Resilience</span><span>' + flags.join(', ') + '</span></div>';
        if (node.resilience.fallback) html += '<div class="detail-row"><span class="detail-label">Fallback</span><span>' + node.resilience.fallback + '</span></div>';
      }

      window.updateDrawerDetail(
        node.name || node.id,
        { text: (node.type || '').replace(/-/g, ' '), style: 'background:' + cfg + '33;color:' + cfg },
        html
      );
    }

    // === PARSE SUMMARY ===
    function parseSummary(text) {
      if (!text) return '';
      return text
        .replace(/\*\*([^*]+)\*\*/g, function(m, name) {
          return '<span class="node-ref" data-node-id="' + name.toLowerCase().replace(/\s+/g, '-') + '" style="color:#7b68ee;cursor:pointer;font-weight:500;border-bottom:1px dotted rgba(123,104,238,0.4)">' + name + '</span>';
        })
        .replace(/\n\n/g, '</p><p>')
        .replace(/^/, '<p>').replace(/$/, '</p>');
    }

    // Init: build sidebar for first journey
    buildSidebar();
  })();
  </script>
</body>
</html>
