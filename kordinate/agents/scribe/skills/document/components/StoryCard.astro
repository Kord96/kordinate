---
/**
 * Renders a single story as a card section within a journey page.
 * Composes: summary + structures (GraphBlock) + flows (SequenceDiagram/TimelineCard)
 *           + observations (ObservationCard) + rationale (RationaleCard)
 *
 * This is the core rendering unit. One StoryCard per story in the journey.
 */
import GraphBlock from './GraphBlock.astro';
import SequenceDiagram from './SequenceDiagram.astro';
import TimelineCard from './TimelineCard.astro';
import ObservationCard from './ObservationCard.astro';
import RationaleCard from './RationaleCard.astro';

interface Props {
  story: any;       // parsed story YAML
  atlas: any;       // atlas.json for node resolution
  rendering: any;   // Scribe's rendering decisions for this story
}

const { story, atlas, rendering } = Astro.props;

// Build observation lookup for inline attachment
const obsMap: Record<string, any> = {};
(story.observations || []).forEach((obs: any) => { obsMap[obs.id] = obs; });

// Collect observation IDs that are attached to nodes/steps (so we don't render them again at the end)
const attachedObsIds = new Set<string>();
(story.structures || []).forEach((s: any) => {
  (s.nodes || []).forEach((n: any) => {
    (n.observation_ids || []).forEach((id: string) => attachedObsIds.add(id));
  });
});
(story.flows || []).forEach((f: any) => {
  (f.steps || []).forEach((s: any) => {
    (s.observation_ids || []).forEach((id: string) => attachedObsIds.add(id));
  });
});
const unattachedObs = (story.observations || []).filter((o: any) => !attachedObsIds.has(o.id));
---

<section class="story-card" id={`story-${story.id}`}>
  <div class="sc-header">
    <h2 class="sc-title">{story.title}</h2>
    {story.tags && story.tags.length > 0 && (
      <div class="sc-tags">
        {story.tags.map((t: string) => <span class="sc-tag">{t}</span>)}
      </div>
    )}
  </div>

  {/* Summary — always present */}
  <div class="sc-summary" set:html={story.summary
    .replace(/\*\*([^*]+)\*\*/g, (_m: string, name: string) => {
      return `<span class="node-ref" data-node-id="${name.toLowerCase().replace(/\s+/g, '-')}">${name}</span>`;
    })
    .replace(/\n\n/g, '</p><p>')
    .replace(/^/, '<p>').replace(/$/, '</p>')
  } />

  {/* Structures */}
  {(story.structures || []).map((s: any) => (
    <div class="sc-block">
      {s.title && <h3 class="sc-block-title">{s.title}</h3>}
      <GraphBlock id={s.id} nodes={s.nodes} edges={s.edges || []} atlas={atlas} structureType={s.type} />
      {/* Inline observations attached to nodes */}
      {s.nodes.filter((n: any) => n.observation_ids?.length > 0).map((n: any) =>
        n.observation_ids.map((oid: string) => obsMap[oid] && (
          <ObservationCard {...obsMap[oid]} />
        ))
      )}
    </div>
  ))}

  {/* Flows */}
  {(story.flows || []).map((f: any) => {
    const isFailure = f.type === 'failure cascade';
    return (
      <div class="sc-block">
        {f.title && <h3 class="sc-block-title">{f.title}</h3>}
        {isFailure ? (
          <TimelineCard
            title={f.title}
            trigger={f.trigger || ''}
            severity={f.severity || 'medium'}
            cascade={f.steps?.map((s: any) => ({ component: s.node, effect: s.effect || s.action || '' })) || []}
            detection={f.detection || ['none']}
            recovery={f.recovery || ['none']}
          />
        ) : (
          <SequenceDiagram id={f.id} steps={f.steps || []} title={f.title} />
        )}
        {/* Inline observations attached to steps */}
        {(f.steps || []).filter((s: any) => s.observation_ids?.length > 0).map((s: any) =>
          s.observation_ids.map((oid: string) => obsMap[oid] && (
            <ObservationCard {...obsMap[oid]} />
          ))
        )}
      </div>
    );
  })}

  {/* Rationale */}
  {(story.rationale || []).map((r: any) => (
    <RationaleCard {...r} />
  ))}

  {/* Unattached observations */}
  {unattachedObs.length > 0 && (
    <div class="sc-observations">
      {unattachedObs.map((obs: any) => (
        <ObservationCard {...obs} />
      ))}
    </div>
  )}
</section>

<style>
  .story-card {
    border: 1px solid var(--border, #475569);
    border-radius: 10px;
    background: var(--bg-secondary, #1e293b);
    padding: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .sc-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .sc-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary, #f1f5f9);
    margin: 0;
  }
  .sc-tags {
    display: flex;
    gap: 0.25rem;
    flex-shrink: 0;
  }
  .sc-tag {
    font-size: 0.65rem;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    background: rgba(255,255,255,0.05);
    color: var(--text-muted, #64748b);
  }
  .sc-summary {
    color: var(--text-secondary, #94a3b8);
    font-size: 0.9rem;
    line-height: 1.55;
    margin-bottom: 0.75rem;
  }
  .sc-summary :global(p) {
    margin: 0 0 0.4rem;
  }
  .sc-block {
    margin-bottom: 0.5rem;
  }
  .sc-block-title {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted, #64748b);
    margin: 0.5rem 0 0.25rem;
  }
  .sc-observations {
    margin-top: 0.5rem;
  }

  /* Clickable node refs in summary */
  .sc-summary :global(.node-ref) {
    color: #7b68ee;
    cursor: pointer;
    font-weight: 500;
    border-bottom: 1px dotted rgba(123,104,238,0.4);
  }
  .sc-summary :global(.node-ref:hover) {
    color: #9d8af7;
    border-bottom-color: #9d8af7;
  }
</style>
