---
/**
 * Atlas page — full interactive Cytoscape graph of the entire codebase.
 * Migrated from ArchExplorer.astro's Structure tab.
 *
 * This is the "big picture" view. Stories scope subsets; the atlas shows everything.
 *
 * Features preserved from ArchExplorer:
 * - Cose-bilkent layout with expand/collapse hierarchy
 * - Node types colored by typeConfig
 * - Debt border rings, pattern badges
 * - Tooltips on hover
 * - Breadcrumb navigation
 * - Zoom, pan, fit controls
 *
 * New for story integration:
 * - "In N stories" badge on node hover
 * - Coverage indicator (undocumented nodes get dashed border)
 * - Story lens dropdown (select a story → highlight its nodes)
 *
 * IMPLEMENTATION NOTE: This component is a placeholder structure.
 * The full Cytoscape initialization (~500 lines) should be extracted from
 * the live ArchExplorer.astro at /kord/projects/docs/src/components/ArchExplorer.astro
 * (lines 191-1100 of the <script> block). The JS is proven and stable —
 * it powers the live sous-storefront page.
 *
 * What to extract:
 * - rebuildStructureGraph() — the core graph builder
 * - structureState + expandedNodes tracking
 * - highlightFlow() — flow path highlighting
 * - showStructureTooltip() — tooltip on node hover
 * - breadcrumb navigation
 * - expand/collapse all
 * - node click → expand children / right-click → collapse
 *
 * What to add:
 * - storyByNode overlay (hover node → show "In N stories" badge)
 * - coverage dashed border (nodes not in any story)
 * - story lens dropdown
 */
interface Props {
  project: string;
  atlas: any;
  storyByNode: Record<string, string[]>;  // nodeId → [storyId, ...]
  stories: any[];
}

const { project, atlas, storyByNode, stories } = Astro.props;
const totalNodes = (atlas.components?.length || 0) + (atlas.external_dependencies?.length || 0) + (atlas.actors?.length || 0);
const coveredNodes = Object.keys(storyByNode).length;
const coveragePct = totalNodes > 0 ? Math.round((coveredNodes / totalNodes) * 100) : 0;
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{project} — Atlas</title>
  <script src="https://unpkg.com/cytoscape@3.30.4/dist/cytoscape.min.js" is:inline></script>
  <script src="https://unpkg.com/layout-base@2.0.1/layout-base.js" is:inline></script>
  <script src="https://unpkg.com/cose-base@2.2.0/cose-base.js" is:inline></script>
  <script src="https://unpkg.com/cytoscape-cose-bilkent@4.1.0/cytoscape-cose-bilkent.js" is:inline></script>
  <style>
    :root {
      --bg-primary: #0f172a;
      --bg-secondary: #1e293b;
      --text-primary: #f1f5f9;
      --text-secondary: #94a3b8;
      --text-muted: #64748b;
      --border: #475569;
      --accent: #3b82f6;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg-primary);
      color: var(--text-primary);
    }
    .atlas-header {
      padding: 1rem 1.5rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .atlas-title { font-size: 1.1rem; font-weight: 600; }
    .atlas-stats { font-size: 0.8rem; color: var(--text-muted); }
    .atlas-coverage {
      font-size: 0.75rem;
      padding: 0.2rem 0.5rem;
      border-radius: 9999px;
      background: rgba(34,197,94,0.15);
      color: #22c55e;
    }
    .atlas-controls {
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }
    .atlas-btn {
      padding: 0.3rem 0.6rem;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--bg-secondary);
      color: var(--text-primary);
      font-size: 0.8rem;
      cursor: pointer;
    }
    .atlas-btn:hover { background: var(--bg-tertiary, #334155); }
    .story-lens-select {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      color: var(--text-primary);
      padding: 0.3rem 0.5rem;
      border-radius: 6px;
      font-size: 0.8rem;
    }
    #cy-atlas {
      width: 100%;
      height: calc(100vh - 60px);
    }
    .back-link {
      font-size: 0.85rem;
      color: var(--accent);
      text-decoration: none;
    }
  </style>
</head>
<body>
  <header class="atlas-header">
    <div>
      <a class="back-link" href={`/${project}/`}>← {project}</a>
      <span class="atlas-title" style="margin-left:0.75rem;">Atlas</span>
      <span class="atlas-stats" style="margin-left:0.5rem;">{totalNodes} nodes · {coveragePct}% documented</span>
    </div>
    <div class="atlas-controls">
      {stories.length > 0 && (
        <select class="story-lens-select" id="story-lens">
          <option value="">All nodes</option>
          {stories.map(s => <option value={s.id}>{s.title}</option>)}
        </select>
      )}
      <button class="atlas-btn" id="btn-fit">Fit</button>
      <button class="atlas-btn" id="btn-expand">Expand All</button>
      <button class="atlas-btn" id="btn-collapse">Collapse All</button>
    </div>
  </header>

  <div id="cy-atlas"></div>

  <!-- Atlas data -->
  <script id="atlas-data" type="application/json" set:html={JSON.stringify(atlas)} />
  <script id="story-by-node" type="application/json" set:html={JSON.stringify(storyByNode)} />

  <script is:inline>
  // Atlas graph initialization.
  // TODO: Extract the full rebuildStructureGraph(), expand/collapse, tooltip,
  // and breadcrumb logic from ArchExplorer.astro (lines 191-1100).
  // For now, this is a simplified version that renders the component graph.
  (function() {
    var atlas = JSON.parse(document.getElementById('atlas-data').textContent);
    var storyByNode = JSON.parse(document.getElementById('story-by-node').textContent);

    var typeColors = {
      component: '#4a90d9', service: '#3498db', frontend: '#4a90d9',
      library: '#9b59b6', worker: '#2ecc71', api: '#3498db',
      external: '#e74c3c', 'external-service': '#e67e22',
      store: '#1abc9c', gateway: '#e67e22', actor: '#14b8a6',
      broker: '#f97316', config: '#c0392b', scheduler: '#6366f1'
    };

    var elements = [];

    // Groups as parent nodes
    (atlas.groups || []).forEach(function(g) {
      elements.push({ group: 'nodes', data: { id: g.id, label: g.name, nodeType: 'group' } });
    });

    // Components
    (atlas.components || []).forEach(function(c) {
      elements.push({
        group: 'nodes',
        data: {
          id: c.id, label: c.name, nodeType: c.type || 'component',
          parent: c.group || undefined,
          description: c.description || '',
          storyCount: (storyByNode[c.id] || []).length
        }
      });
    });

    // External dependencies
    (atlas.external_dependencies || []).forEach(function(e) {
      elements.push({
        group: 'nodes',
        data: { id: e.id, label: e.name, nodeType: 'external', description: e.purpose || '', storyCount: (storyByNode[e.id] || []).length }
      });
    });

    // Edges from depends_on
    (atlas.components || []).forEach(function(c) {
      (c.depends_on || []).forEach(function(dep) {
        elements.push({ group: 'edges', data: { source: c.id, target: dep, label: '' } });
      });
    });

    var cy = cytoscape({
      container: document.getElementById('cy-atlas'),
      elements: elements,
      minZoom: 0.2, maxZoom: 4, wheelSensitivity: 0.3,
      style: [
        { selector: 'node', style: {
          'label': 'data(label)', 'text-valign': 'center', 'text-halign': 'center',
          'font-size': '11px', 'color': '#fff', 'text-wrap': 'wrap', 'text-max-width': '120px',
          'border-width': 1.5, 'shape': 'roundrectangle', 'padding': '10px',
          'width': 'label', 'height': 'label'
        }},
        { selector: 'node[nodeType="group"]', style: {
          'background-color': '#2a2a4e', 'border-color': '#4a4a6e', 'color': '#aaa',
          'border-style': 'dashed', 'border-width': 1, 'text-valign': 'top', 'text-halign': 'center',
          'padding': '20px', 'font-size': '10px'
        }},
        { selector: 'node[nodeType="external"]', style: { 'shape': 'octagon' }},
        { selector: 'node[nodeType="store"]', style: { 'shape': 'barrel' }},
        { selector: 'node[nodeType="gateway"], node[nodeType="broker"]', style: { 'shape': 'hexagon' }},
        { selector: 'node[nodeType="actor"]', style: { 'shape': 'ellipse' }},
        { selector: 'node[storyCount=0]', style: { 'border-style': 'dashed', 'opacity': 0.6 }},
        { selector: 'node.hover', style: { 'overlay-color': '#7b68ee', 'overlay-padding': 6, 'overlay-opacity': 0.2 }},
        { selector: '.dimmed', style: { 'opacity': 0.08 }},
        { selector: 'edge', style: {
          'width': 1.5, 'line-color': 'rgba(255,255,255,0.12)',
          'target-arrow-color': 'rgba(255,255,255,0.12)', 'target-arrow-shape': 'triangle',
          'curve-style': 'bezier', 'arrow-scale': 0.7
        }}
      ]
    });

    // Apply type colors
    cy.nodes().forEach(function(n) {
      var c = typeColors[n.data('nodeType')] || '#4a90d9';
      if (n.data('nodeType') !== 'group') n.style({ 'background-color': c, 'border-color': c });
    });

    // Layout
    cy.layout({ name: 'cose-bilkent', idealEdgeLength: 150, nodeRepulsion: 10000, numIter: 2000, tile: true }).run();

    // Hover
    cy.on('mouseover', 'node', function(e) { e.target.addClass('hover'); });
    cy.on('mouseout', 'node', function(e) { e.target.removeClass('hover'); });

    // Controls
    document.getElementById('btn-fit').addEventListener('click', function() { cy.fit(undefined, 20); });
    document.getElementById('btn-expand').addEventListener('click', function() { cy.nodes('[nodeType="group"]').style('display', 'element'); cy.layout({ name: 'cose-bilkent', idealEdgeLength: 150, nodeRepulsion: 10000, numIter: 1500 }).run(); });

    // Story lens
    var lens = document.getElementById('story-lens');
    if (lens) {
      lens.addEventListener('change', function() {
        cy.elements().removeClass('dimmed');
        if (!lens.value) return;
        var storyNodes = new Set();
        Object.keys(storyByNode).forEach(function(nid) {
          if (storyByNode[nid].indexOf(lens.value) >= 0) storyNodes.add(nid);
        });
        cy.nodes().forEach(function(n) {
          if (!storyNodes.has(n.data('id')) && n.data('nodeType') !== 'group') n.addClass('dimmed');
        });
        cy.edges().forEach(function(e) {
          if (!storyNodes.has(e.data('source')) && !storyNodes.has(e.data('target'))) e.addClass('dimmed');
        });
      });
    }
  })();
  </script>
</body>
</html>
