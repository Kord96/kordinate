---
/**
 * Renders a Cytoscape graph for a structure block.
 * Lazy-loads Cytoscape on interaction — shows a placeholder until then.
 * Layout chosen by node count: 1-3 inline, 4-8 dagre, 9+ cose-bilkent.
 */
interface Node {
  id: string;
  name?: string;
  type?: string;
  children?: string[];
}

interface Edge {
  from: string;
  to: string;
  label?: string;
  type?: string;
}

interface Props {
  id: string;
  nodes: Node[];
  edges: Edge[];
  atlas: any;
  structureType?: string;
}

const { id, nodes, edges, atlas, structureType } = Astro.props;

// Resolve node metadata from atlas
const resolvedNodes = nodes.map(n => {
  const atlasNode = atlas.components?.find((c: any) => c.id === n.id)
    || atlas.external_dependencies?.find((e: any) => e.id === n.id)
    || atlas.actors?.find((a: any) => a.id === n.id);
  return {
    id: n.id,
    name: atlasNode?.name || n.id.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase()),
    type: atlasNode?.type || 'component',
    description: atlasNode?.description || '',
  };
});

const graphData = JSON.stringify({ nodes: resolvedNodes, edges });
const nodeCount = nodes.length;
const layout = nodeCount <= 3 ? 'grid' : nodeCount <= 8 ? 'dagre' : 'cose-bilkent';
---

<div class="graph-block" id={`graph-${id}`} data-graph={graphData} data-layout={layout}>
  <div class="graph-container"></div>
  <div class="graph-placeholder">
    <div class="graph-nodes-preview">
      {resolvedNodes.map(n => (
        <span class="gp-node" data-type={n.type} title={n.description}>{n.name}</span>
      ))}
    </div>
    <div class="graph-hint">hover to interact</div>
  </div>
</div>

<style>
  .graph-block {
    position: relative;
    border: 1px solid var(--border, #475569);
    border-radius: 8px;
    background: var(--bg-primary, #0f172a);
    min-height: 200px;
    margin: 0.5rem 0;
    overflow: hidden;
  }
  .graph-container {
    width: 100%;
    height: 280px;
    display: none;
  }
  .graph-container.active {
    display: block;
  }
  .graph-placeholder {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .graph-placeholder.hidden { display: none; }
  .graph-nodes-preview {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }
  .gp-node {
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    font-size: 0.8rem;
    border: 1px solid rgba(255,255,255,0.15);
    color: var(--text-primary, #f1f5f9);
    cursor: default;
  }
  /* Type colors on placeholder nodes */
  .gp-node[data-type="service"] { background: rgba(52,152,219,0.2); border-color: rgba(52,152,219,0.4); }
  .gp-node[data-type="external"], .gp-node[data-type="external-service"] { background: rgba(231,76,60,0.2); border-color: rgba(231,76,60,0.4); }
  .gp-node[data-type="store"] { background: rgba(26,188,156,0.2); border-color: rgba(26,188,156,0.4); }
  .gp-node[data-type="library"] { background: rgba(155,89,182,0.2); border-color: rgba(155,89,182,0.4); }
  .gp-node[data-type="worker"] { background: rgba(46,204,113,0.2); border-color: rgba(46,204,113,0.4); }
  .gp-node[data-type="gateway"] { background: rgba(230,126,34,0.2); border-color: rgba(230,126,34,0.4); }
  .gp-node[data-type="actor"] { background: rgba(20,184,166,0.2); border-color: rgba(20,184,166,0.4); }
  .gp-node[data-type="api"] { background: rgba(52,152,219,0.2); border-color: rgba(52,152,219,0.4); }
  .gp-node[data-type="frontend"] { background: rgba(74,144,217,0.2); border-color: rgba(74,144,217,0.4); }
  .gp-node[data-type="component"] { background: rgba(74,144,217,0.2); border-color: rgba(74,144,217,0.4); }
  .graph-hint {
    font-size: 0.7rem;
    color: var(--text-muted, #64748b);
    opacity: 0.6;
  }
</style>

<script is:inline>
// Lazy-load Cytoscape on hover
(function() {
  var loaded = {};
  document.querySelectorAll('.graph-block').forEach(function(block) {
    var init = function() {
      if (loaded[block.id]) return;
      loaded[block.id] = true;
      var data = JSON.parse(block.dataset.graph);
      var layoutName = block.dataset.layout;
      var container = block.querySelector('.graph-container');
      var placeholder = block.querySelector('.graph-placeholder');

      // Load Cytoscape if not already loaded
      function go() {
        if (typeof cytoscape === 'undefined') return setTimeout(go, 100);

        container.classList.add('active');
        placeholder.classList.add('hidden');

        var typeColors = {
          component: '#4a90d9', service: '#3498db', frontend: '#4a90d9',
          library: '#9b59b6', worker: '#2ecc71', api: '#3498db',
          external: '#e74c3c', 'external-service': '#e67e22',
          store: '#1abc9c', gateway: '#e67e22', actor: '#14b8a6',
          broker: '#f97316', config: '#c0392b'
        };

        var elements = [];
        data.nodes.forEach(function(n) {
          elements.push({
            group: 'nodes',
            data: { id: n.id, label: n.name || n.id, nodeType: n.type || 'component' }
          });
        });
        data.edges.forEach(function(e) {
          elements.push({
            group: 'edges',
            data: { source: e.from, target: e.to, label: e.label || '' }
          });
        });

        var cy = cytoscape({
          container: container,
          elements: elements,
          minZoom: 0.3, maxZoom: 3, wheelSensitivity: 0.3,
          style: [
            { selector: 'node', style: {
              'label': 'data(label)', 'text-valign': 'center', 'text-halign': 'center',
              'font-size': '10px', 'color': '#fff', 'text-wrap': 'wrap', 'text-max-width': '100px',
              'border-width': 1.5, 'width': 'label', 'height': 'label',
              'padding': '8px', 'shape': 'roundrectangle'
            }},
            { selector: 'edge', style: {
              'width': 1.5, 'line-color': 'rgba(255,255,255,0.2)',
              'target-arrow-color': 'rgba(255,255,255,0.2)', 'target-arrow-shape': 'triangle',
              'curve-style': 'bezier', 'arrow-scale': 0.7,
              'label': 'data(label)', 'font-size': '8px', 'color': 'rgba(255,255,255,0.5)',
              'text-background-color': '#0f172a', 'text-background-opacity': 0.8, 'text-background-padding': '2px'
            }},
            { selector: 'node.hover', style: {
              'overlay-color': '#7b68ee', 'overlay-padding': 5, 'overlay-opacity': 0.2
            }}
          ]
        });

        // Apply type colors
        cy.nodes().forEach(function(n) {
          var c = typeColors[n.data('nodeType')] || '#4a90d9';
          n.style({ 'background-color': c, 'border-color': c });
        });

        // Layout
        var layoutOpts = layoutName === 'dagre'
          ? { name: 'dagre', rankDir: 'LR', nodeSep: 40, rankSep: 80 }
          : layoutName === 'cose-bilkent'
          ? { name: 'cose-bilkent', idealEdgeLength: 120, nodeRepulsion: 8000, numIter: 1500 }
          : { name: 'grid', rows: 1, padding: 30 };

        // Dagre may not be loaded — fallback to grid
        try { cy.layout(layoutOpts).run(); }
        catch(e) { cy.layout({ name: 'grid', padding: 30 }).run(); }

        cy.fit(undefined, 20);

        // Hover
        cy.on('mouseover', 'node', function(e) { e.target.addClass('hover'); });
        cy.on('mouseout', 'node', function(e) { e.target.removeClass('hover'); });
      }
      go();
    };

    block.addEventListener('mouseenter', init, { once: true });
  });
})();
</script>
