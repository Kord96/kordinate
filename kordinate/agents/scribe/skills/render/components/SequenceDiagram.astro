---
/**
 * Renders a Mermaid sequence diagram from flow steps.
 * Generates DSL from structured step data. Lazy-renders on visibility.
 */
interface Step {
  node: string;
  action?: string;
  effect?: string;
  to?: string;
  technology?: string;
}

interface Props {
  id: string;
  steps: Step[];
  title?: string;
}

const { id, steps, title } = Astro.props;

// Generate Mermaid DSL from steps
const lines = ['sequenceDiagram', '    autonumber'];
for (const step of steps) {
  const label = step.action || step.effect || '';
  const shortLabel = label.length > 60 ? label.substring(0, 57) + '...' : label;
  if (step.to) {
    lines.push(`    ${step.node}->>${step.to}: ${shortLabel}`);
  }
}
const mermaidDsl = lines.join('\n');
---

<div class="sequence-block" id={`seq-${id}`}>
  {title && <div class="seq-title">{title}</div>}
  <div class="mermaid-container">
    <pre class="mermaid-src" style="display:none">{mermaidDsl}</pre>
    <div class="mermaid-render"></div>
  </div>
</div>

<style>
  .sequence-block {
    margin: 0.5rem 0;
    border: 1px solid var(--border, #475569);
    border-radius: 8px;
    background: var(--bg-primary, #0f172a);
    overflow: hidden;
  }
  .seq-title {
    padding: 0.4rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary, #94a3b8);
    border-bottom: 1px solid var(--border, #475569);
  }
  .mermaid-container {
    padding: 1rem;
    overflow-x: auto;
  }
  .mermaid-render :global(svg) {
    max-width: 100%;
  }
</style>

<script is:inline>
// Render Mermaid diagrams when they become visible
(function() {
  var rendered = {};
  function renderAll() {
    document.querySelectorAll('.sequence-block').forEach(function(block) {
      if (rendered[block.id]) return;
      var rect = block.getBoundingClientRect();
      if (rect.top > window.innerHeight + 200 || rect.bottom < -200) return;

      rendered[block.id] = true;
      var src = block.querySelector('.mermaid-src');
      var target = block.querySelector('.mermaid-render');
      if (!src || !target || typeof mermaid === 'undefined') return;

      mermaid.render('mermaid-svg-' + block.id, src.textContent.trim())
        .then(function(result) { target.innerHTML = result.svg; })
        .catch(function() { target.innerHTML = '<pre>' + src.textContent + '</pre>'; });
    });
  }
  // Init mermaid with dark theme
  if (typeof mermaid !== 'undefined') {
    mermaid.initialize({
      startOnLoad: false,
      theme: 'dark',
      themeVariables: {
        primaryColor: '#2a2a5e',
        primaryBorderColor: '#7b68ee',
        primaryTextColor: '#ddd',
        lineColor: '#7b68ee',
        sequenceNumberColor: '#1a1a2e',
        actorMargin: 50,
        messageMargin: 35
      }
    });
  }
  window.addEventListener('scroll', renderAll, { passive: true });
  setTimeout(renderAll, 100);
})();
</script>
