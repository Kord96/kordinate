  {"type": "file", "path": "shared/memory-protocol.md", "description": "Memory writing protocol", "owner": "team", "preload": "all", "validation": "scribe"},
  {"type": "file", "path": "shared/gemini-protocol.md", "description": "Gemini CLI usage and flags", "owner": "team", "preload": "all", "validation": "scribe"},
  {"type": "file", "path": "agents/main/memory/scratchpad.md", "description": "Main session working notes", "owner": "main", "preload": "none"}
