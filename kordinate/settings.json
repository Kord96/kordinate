{
  "env": {
    "KORDINATE_HOME": "$HOME/.kord"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$KORDINATE_HOME/hooks/guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__grafana",
        "hooks": [
          {
            "type": "command",
            "command": "$KORDINATE_HOME/hooks/guard.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$KORDINATE_HOME/hooks/agent-memory.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$KORDINATE_HOME/hooks/auto-merge-to-dev.sh"
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true
}
