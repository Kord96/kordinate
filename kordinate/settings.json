{
  "env": {
    "KORDINATE_HOME": "$HOME/.kord"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$KORDINATE_HOME/hooks/guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__grafana",
        "hooks": [
          {
            "type": "command",
            "command": "$KORDINATE_HOME/hooks/guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$KORDINATE_HOME/hooks/worktree-push.sh"
          }
        ]
      }
    ]
  },
  "effortLevel": "max",
  "skipDangerousModePermissionPrompt": true
}
